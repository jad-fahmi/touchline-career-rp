<!--
  One type scale for the whole app. Sizes step on a 1.25 ratio from 11 so headings, metrics and
  body copy line up optically instead of each view inventing its own FontSize.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Palette.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <sys:Double x:Key="Size.Caption">11</sys:Double>
  <sys:Double x:Key="Size.Small">12</sys:Double>
  <sys:Double x:Key="Size.Body">14</sys:Double>
  <sys:Double x:Key="Size.Lead">16</sys:Double>
  <sys:Double x:Key="Size.Title">20</sys:Double>
  <sys:Double x:Key="Size.Heading">26</sys:Double>
  <sys:Double x:Key="Size.Display">34</sys:Double>

  <!-- Page title, one per view -->
  <Style x:Key="Heading" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
    <Setter Property="FontSize" Value="{StaticResource Size.Heading}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
  </Style>

  <!-- The one-line explanation that sits under a page title -->
  <Style x:Key="Subheading" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="0,0,0,18"/>
  </Style>

  <!-- Card / section title -->
  <Style x:Key="CardTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
    <Setter Property="FontSize" Value="{StaticResource Size.Title}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- Small uppercase eyebrow above a value. The workhorse label of this UI. -->
  <Style x:Key="Label" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Faint}"/>
    <Setter Property="FontSize" Value="{StaticResource Size.Caption}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="0,0,0,6"/>
  </Style>

  <!-- Field label inside a form. Sentence case, sits directly on the input. -->
  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    <Setter Property="FontSize" Value="{StaticResource Size.Small}"/>
    <Setter Property="Margin" Value="2,0,0,4"/>
  </Style>

  <!-- The number or short answer a card exists to show -->
  <Style x:Key="Metric" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
    <Setter Property="FontSize" Value="{StaticResource Size.Display}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="MetricSmall" TargetType="TextBlock" BasedOn="{StaticResource Metric}">
    <Setter Property="FontSize" Value="{StaticResource Size.Title}"/>
  </Style>

  <Style x:Key="Body" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="LineHeight" Value="21"/>
  </Style>

  <Style x:Key="BodyMuted" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
  </Style>

  <!-- Prose the player actually reads: briefings, scouting, interviews -->
  <Style x:Key="Prose" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Setter Property="FontSize" Value="{StaticResource Size.Lead}"/>
    <Setter Property="LineHeight" Value="26"/>
  </Style>

  <Style x:Key="Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Size.Caption}"/>
    <Setter Property="Foreground" Value="{StaticResource Faint}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="Mono" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="FontSize" Value="{StaticResource Size.Small}"/>
    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- Glyph that takes its colour from whatever contains it, so it can live inside a button and
       follow that button's hover and pressed states. -->
  <Style x:Key="Glyph" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
  </Style>

  <!-- Glyph from the shipped Windows icon font -->
  <Style x:Key="Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
  </Style>

</ResourceDictionary>

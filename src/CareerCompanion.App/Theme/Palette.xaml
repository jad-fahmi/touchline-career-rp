<!--
  Touchline palette.

  The identity stays the same as the original build - deep indigo pitch-at-night, gold accent,
  lime interactive - but the ramp is rebuilt so surfaces separate by luminance instead of hue,
  which is what makes a dark UI readable. Every brush here is a role, not a colour name, so a
  view never has to guess which purple it wants.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Raw colours. Views should use the brushes below, not these. -->
  <Color x:Key="C.Base">#14103A</Color>
  <Color x:Key="C.Sidebar">#0F0C2B</Color>
  <Color x:Key="C.Panel">#221C54</Color>
  <Color x:Key="C.PanelRaised">#2C2565</Color>
  <Color x:Key="C.PanelHover">#372F78</Color>
  <Color x:Key="C.Stroke">#3E3679</Color>
  <Color x:Key="C.StrokeStrong">#5A5386</Color>
  <Color x:Key="C.Text">#EEEDF8</Color>
  <Color x:Key="C.Muted">#A7A4CC</Color>
  <Color x:Key="C.Faint">#6E6A9B</Color>
  <Color x:Key="C.Accent">#F2C313</Color>
  <Color x:Key="C.Interactive">#B8E52A</Color>
  <Color x:Key="C.Danger">#E4576A</Color>
  <Color x:Key="C.Warm">#E9952F</Color>
  <Color x:Key="C.Win">#4FD18B</Color>
  <Color x:Key="C.Draw">#9C97C8</Color>
  <Color x:Key="C.Shadow">#0A0820</Color>
  <Color x:Key="C.Ink">#0B0918</Color>

  <!-- Surfaces -->
  <SolidColorBrush x:Key="Bg" Color="{StaticResource C.Base}"/>
  <SolidColorBrush x:Key="Sidebar" Color="{StaticResource C.Sidebar}"/>
  <SolidColorBrush x:Key="Panel" Color="{StaticResource C.Panel}"/>
  <SolidColorBrush x:Key="Panel2" Color="{StaticResource C.PanelRaised}"/>
  <SolidColorBrush x:Key="PanelHover" Color="{StaticResource C.PanelHover}"/>
  <SolidColorBrush x:Key="Shadow" Color="{StaticResource C.Shadow}"/>

  <!-- Lines -->
  <SolidColorBrush x:Key="Stroke" Color="{StaticResource C.Stroke}"/>
  <SolidColorBrush x:Key="StrokeStrong" Color="{StaticResource C.StrokeStrong}"/>

  <!-- Type -->
  <SolidColorBrush x:Key="Text" Color="{StaticResource C.Text}"/>
  <SolidColorBrush x:Key="Muted" Color="{StaticResource C.Muted}"/>
  <SolidColorBrush x:Key="Faint" Color="{StaticResource C.Faint}"/>

  <!--
    Ink for anything that sits on a bright fill - lime, gold, orange, green. Those fills are far
    too light for the near-white body colour, so text on them is always this near-black instead.
    If a surface is painted with Interactive, Accent, Warm or Win, its text uses this brush.
  -->
  <SolidColorBrush x:Key="InkOnBright" Color="{StaticResource C.Ink}"/>

  <!-- Signals -->
  <SolidColorBrush x:Key="Accent" Color="{StaticResource C.Accent}"/>
  <SolidColorBrush x:Key="Interactive" Color="{StaticResource C.Interactive}"/>
  <SolidColorBrush x:Key="Danger" Color="{StaticResource C.Danger}"/>
  <SolidColorBrush x:Key="Warm" Color="{StaticResource C.Warm}"/>
  <SolidColorBrush x:Key="Win" Color="{StaticResource C.Win}"/>
  <SolidColorBrush x:Key="Draw" Color="{StaticResource C.Draw}"/>
  <SolidColorBrush x:Key="Loss" Color="{StaticResource C.Danger}"/>

  <!-- Translucent washes used for tinted rows, chips, and hover states -->
  <SolidColorBrush x:Key="AccentWash" Color="#26F2C313"/>
  <SolidColorBrush x:Key="InteractiveWash" Color="#22B8E52A"/>
  <SolidColorBrush x:Key="DangerWash" Color="#26E4576A"/>
  <SolidColorBrush x:Key="WinWash" Color="#264FD18B"/>
  <SolidColorBrush x:Key="OverlayScrim" Color="#B2080618"/>
  <SolidColorBrush x:Key="RowHover" Color="#1AFFFFFF"/>
  <SolidColorBrush x:Key="RowSelected" Color="#2EB8E52A"/>

  <!-- Feature gradients: used sparingly, for the shell and the one hero card per page -->
  <LinearGradientBrush x:Key="HeroFill" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#2E2670" Offset="0"/>
    <GradientStop Color="#221C54" Offset="0.55"/>
    <GradientStop Color="#1B1546" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="SidebarFill" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#151034" Offset="0"/>
    <GradientStop Color="#0F0C2B" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="BrandRule" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#F2C313" Offset="0"/>
    <GradientStop Color="#B8E52A" Offset="0.5"/>
    <GradientStop Color="#E4576A" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AccentSweep" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#00B8E52A" Offset="0"/>
    <GradientStop Color="#B8E52A" Offset="0.5"/>
    <GradientStop Color="#00B8E52A" Offset="1"/>
  </LinearGradientBrush>

</ResourceDictionary>

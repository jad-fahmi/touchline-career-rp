<Window x:Class="CareerCompanion.App.ProfileEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Character Profile Editor" Width="800" Height="700" WindowStartupLocation="CenterOwner">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock x:Name="NameText" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Historical truth, save fiction, and simulated interpretation remain separate." Foreground="{StaticResource Muted}" Margin="0,5,0,16"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Hard facts (JSON)" Style="{StaticResource Label}"/><TextBox x:Name="FactsBox" AcceptsReturn="True" MinHeight="90" FontFamily="Consolas"/><TextBlock Text="Public personality (JSON)" Style="{StaticResource Label}"/><TextBox x:Name="PersonalityBox" AcceptsReturn="True" MinHeight="180" FontFamily="Consolas"/><TextBlock Text="Communication style (JSON)" Style="{StaticResource Label}"/><TextBox x:Name="CommunicationBox" AcceptsReturn="True" MinHeight="130" FontFamily="Consolas"/><TextBlock Text="Historical notes (real-world context only)" Style="{StaticResource Label}"/><TextBox x:Name="HistoricalBox" AcceptsReturn="True" MinHeight="90"/><CheckBox x:Name="PublicBox" Content="Public/media character"/></StackPanel></ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="IMPORT JSON" Click="Import_Click" Style="{StaticResource SecondaryButton}"/><Button Content="EXPORT JSON" Click="Export_Click" Style="{StaticResource SecondaryButton}"/><Button Content="SAVE PROFILE" Click="Accept_Click"/></StackPanel>
  </Grid>
</Window>

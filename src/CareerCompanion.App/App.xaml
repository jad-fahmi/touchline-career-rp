<Application x:Class="CareerCompanion.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:CareerCompanion.App"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Controls pulls in Palette and Typography, so this is the whole theme. -->
        <ResourceDictionary Source="Theme/Controls.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <app:FormPillsConverter x:Key="FormPills"/>
      <app:EmptyToVisibilityConverter x:Key="Empty"/>
      <app:BoolToVisibilityConverter x:Key="Bool"/>
      <app:RatingToBrushConverter x:Key="RatingBrush"/>
      <app:OverallToBrushConverter x:Key="OverallBrush"/>
      <app:ImportanceToBrushConverter x:Key="ImportanceBrush"/>
      <app:AvailabilityToBrushConverter x:Key="AvailabilityBrush"/>
      <app:InitialsConverter x:Key="Initials"/>
      <app:HumanizeConverter x:Key="Humanize"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>

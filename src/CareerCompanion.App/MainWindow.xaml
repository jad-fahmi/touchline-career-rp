<Window x:Class="CareerCompanion.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Touchline | Career Companion" Width="1320" Height="820" MinWidth="1050" MinHeight="680" WindowStartupLocation="CenterScreen">
  <Grid Background="{StaticResource Bg}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource Shadow}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
      <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0"><TextBlock Text="TOUCHLINE" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="CAREER WORLD" Style="{StaticResource Label}" Margin="0,2,0,8"/><StackPanel Orientation="Horizontal" Margin="0,0,0,20"><Border Width="68" Height="3" Background="{StaticResource Accent}"/><Border Width="32" Height="3" Background="{StaticResource Warm}"/><Border Width="18" Height="3" Background="{StaticResource Danger}"/></StackPanel></StackPanel>
        <ListBox Grid.Row="1" x:Name="Navigation" SelectionChanged="Navigation_Changed" SelectedIndex="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.Resources><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,1"/><Setter Property="FontWeight" Value="SemiBold"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource Panel2}"/><Setter Property="Foreground" Value="{StaticResource Interactive}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Panel}"/></Trigger></Style.Triggers></Style></ListBox.Resources>
          <ListBoxItem Content="HOME"/><ListBoxItem><Grid Width="190"><TextBlock Text="WORLD UPDATES"/><Border Background="{StaticResource Danger}" CornerRadius="9" Padding="5,1" HorizontalAlignment="Right" Visibility="{Binding UnreadNotificationBadgeVisibility}"><TextBlock Text="{Binding UnreadNotificationCount}" Foreground="{StaticResource Text}" FontSize="11" FontWeight="Bold"/></Border></Grid></ListBoxItem><ListBoxItem Content="PRE-MATCH"/><ListBoxItem Content="REVIEW INBOX"/><ListBoxItem Content="CAREER"/><ListBoxItem Content="MATCH"/><ListBoxItem Content="SQUAD"/><ListBoxItem><Grid Width="190"><TextBlock Text="MESSAGES"/><Border Background="{StaticResource Danger}" CornerRadius="9" Padding="5,1" HorizontalAlignment="Right" Visibility="{Binding UnreadMessageBadgeVisibility}"><TextBlock Text="{Binding UnreadMessageCount}" Foreground="{StaticResource Text}" FontSize="11" FontWeight="Bold"/></Border></Grid></ListBoxItem><ListBoxItem Content="MANAGER"/><ListBoxItem Content="PRESS"/><ListBoxItem Content="NEWS"/><ListBoxItem Content="SOCIAL"/><ListBoxItem Content="TIMELINE"/><ListBoxItem Content="SETTINGS"/><ListBoxItem Content="DEBUG" Visibility="{Binding DebugVisibility}"/>
        </ListBox>
        <StackPanel Grid.Row="2"><TextBlock Text="ACTIVE SAVE" Style="{StaticResource Label}"/><TextBlock Text="{Binding CurrentCareer.SaveName, FallbackValue=No career}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="28,22,20,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,14"><TextBlock Text="{Binding CurrentCareer.Club}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="RESTORE BACKUP" Click="Restore_Click" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,8,0"/><Button Content="EDIT SELECTED PROFILE" Click="EditProfile_Click" Padding="10,4" Margin="0,0,14,0"/><TextBlock Text="{Binding CurrentCareer.Season}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel></DockPanel>
      <Border Grid.Row="1" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="12,8" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="{StaticResource Interactive}" Padding="9,4" VerticalAlignment="Center"><TextBlock Text="{Binding FifaSyncBadge}" Foreground="{StaticResource Shadow}" FontWeight="Bold" FontSize="11"/></Border><StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="{Binding FifaSyncStatus}" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="{StaticResource Muted}" FontSize="11"><Run Text="{Binding LastFifaSyncText, Mode=OneWay}"/><Run Text=" | "/><Run Text="{Binding FifaSourceText, Mode=OneWay}"/></TextBlock></StackPanel><Button Grid.Column="2" Content="REVIEW MATCH" Click="ReviewFifaMatch_Click" Visibility="{Binding FifaReviewVisibility}" Padding="12,5" Margin="0"/></Grid></Border>
      <Grid Grid.Row="2">
        <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="Career briefing" Style="{StaticResource Heading}"/>
          <Border Style="{StaticResource Card}" Visibility="{Binding NoCareerVisibility}"><StackPanel><TextBlock Text="Start your football world" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Create a career in the Career section. LLM setup can wait; manual simulation works fully offline." Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
          <WrapPanel><Border Style="{StaticResource Card}" Width="330"><StackPanel><TextBlock Text="PLAYER" Style="{StaticResource Label}"/><TextBlock Text="{Binding CurrentCareer.PlayerName}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding PlayerSummary}" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/><TextBlock Text="{Binding InternationalSummary}" Foreground="{StaticResource Interactive}" Margin="0,4,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="330"><StackPanel><TextBlock Text="RECENT MATCH" Style="{StaticResource Label}"/><TextBlock Text="{Binding RecentMatchSummary}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding CurrentForm}" Foreground="{StaticResource Accent}" Margin="0,4,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="330"><StackPanel><TextBlock Text="NEXT FIXTURE" Style="{StaticResource Label}"/><TextBlock Text="{Binding NextFixture}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Automatically read from FIFA previews" Foreground="{StaticResource Muted}"/></StackPanel></Border></WrapPanel>
          <WrapPanel><Border Style="{StaticResource Card}" Width="500"><StackPanel><TextBlock Text="INCOMING" Style="{StaticResource Label}"/><TextBlock Text="{Binding NotificationBadge}" Foreground="{StaticResource Interactive}" FontWeight="Bold"/><TextBlock Text="{Binding LatestIncoming}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="500"><StackPanel><TextBlock Text="LATEST HEADLINE" Style="{StaticResource Label}"/><TextBlock Text="{Binding LatestHeadline}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Foreground="{StaticResource Muted}" Margin="0,5,0,0"><Run Text="Manager: "/><Run Text="{Binding ManagerName, Mode=OneWay}"/></TextBlock></StackPanel></Border></WrapPanel>
          <Border Style="{StaticResource Card}" Background="{StaticResource Panel2}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PLAYER WELLBEING" Style="{StaticResource Label}"/><TextBlock Text="{Binding PlayerMindsetTitle}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="{Binding PlayerMindsetSummary}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="22,0,0,0"><TextBlock Text="{Binding PlayerMindsetDetail}" FontSize="16" TextWrapping="Wrap" LineHeight="23"/><StackPanel Orientation="Horizontal" Visibility="{Binding RecoveryChoiceVisibility}" Margin="0,10,0,0"><Button Content="OPEN UP" Click="OpenUp_Click" Width="125"/><Button Content="RECOVERY DAY" Click="RecoveryDay_Click" Width="150" Style="{StaticResource SecondaryButton}"/><Button Content="TRAINING RESET" Click="TrainingReset_Click" Width="160" Style="{StaticResource SecondaryButton}"/></StackPanel><TextBlock Text="Choose one response after each match. It changes how pressure, confidence, fatigue, and isolation carry into the next fixture." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Grid></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="LATEST WORLD ACTIVITY" Style="{StaticResource Label}"/><ItemsControl ItemsSource="{Binding DashboardItems}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,9,0,0" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        </StackPanel></ScrollViewer>

        <ScrollViewer x:Name="WorldInboxPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
          <DockPanel><StackPanel><TextBlock Text="World updates" Style="{StaticResource Heading}"/><TextBlock Text="{Binding NotificationBadge}" Foreground="{StaticResource Interactive}" FontWeight="Bold"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="MARK ALL READ" Click="MarkWorldRead_Click" Style="{StaticResource SecondaryButton}"/><Button Content="CLEAR READ" Click="ClearWorldRead_Click" Style="{StaticResource SecondaryButton}"/></StackPanel></DockPanel>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="CAREER PROGRESSION" Style="{StaticResource Label}"/><TextBlock Text="{Binding ProgressSummary}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Automatically captured from each distinct FIFA save snapshot." Foreground="{StaticResource Muted}"/></StackPanel></Border>
          <ListBox ItemsSource="{Binding Notifications}" SelectedItem="{Binding SelectedNotification}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Kind}" Foreground="{StaticResource Accent}" FontWeight="Bold"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Body}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding CreatedAt,StringFormat={}{0:dd MMM HH:mm}}" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="NEW" Foreground="{StaticResource Interactive}" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsRead}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><Button Content="OPEN SELECTED UPDATE" Click="OpenWorldUpdate_Click" Width="210" HorizontalAlignment="Left"/>
        </StackPanel></ScrollViewer>

        <ScrollViewer x:Name="PreMatchPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="Pre-match briefing" Style="{StaticResource Heading}"/>
          <Border Style="{StaticResource Card}" Background="{StaticResource Panel2}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="NEXT OPPONENT" Style="{StaticResource Label}"/><TextBlock Text="{Binding PreMatchOpponent}" FontSize="32" FontWeight="Bold"/><TextBlock Text="{Binding PreMatchMeta}" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="MATCHDAY" Foreground="{StaticResource Accent}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/></Grid></Border>
          <UniformGrid Columns="3"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="RECENT FORM" Style="{StaticResource Label}"/><TextBlock Text="{Binding PreMatchForm}" Foreground="{StaticResource Accent}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="AVAILABILITY" Style="{StaticResource Label}"/><TextBlock Text="{Binding PreMatchAvailability}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="KEY PLAYERS" Style="{StaticResource Label}"/><TextBlock Text="{Binding PreMatchKeyPlayers}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border></UniformGrid>
          <Border Style="{StaticResource Card}" Background="{StaticResource Panel2}"><StackPanel><TextBlock Text="FIFA MATCH BRIEFING" Style="{StaticResource Label}"/><TextBlock Text="{Binding PreMatchIntel}" TextWrapping="Wrap" FontSize="15" LineHeight="22"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="OPPOSITION SCOUTING" Style="{StaticResource Label}"/><TextBlock Text="{Binding PreMatchScouting}" TextWrapping="Wrap" FontSize="15" LineHeight="23"/><TextBlock Text="Grounded in the opponent squad, manager, rivalry, and venue records available in the latest FIFA save." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PREPARE" Style="{StaticResource Label}"/><TextBlock Text="Set the tone before kickoff. Conversations open with the fixture context already prepared." Foreground="{StaticResource Muted}" Margin="0,5,0,10"/><WrapPanel><Button Content="TALK TO TEAMMATE" Click="TalkTeammate_Click" Width="180"/><Button Content="TALK TO MANAGER" Click="TalkManager_Click" Width="180"/><Button Content="OPEN PRESS ROOM" Click="OpenPress_Click" Width="180" Style="{StaticResource SecondaryButton}"/></WrapPanel></StackPanel></Border>
        </StackPanel></ScrollViewer>

        <ScrollViewer x:Name="ReviewInboxPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
          <DockPanel><TextBlock Text="Match review inbox" Style="{StaticResource Heading}"/><TextBlock DockPanel.Dock="Right" Text="{Binding MatchReviewCount}" Foreground="{StaticResource Accent}" FontWeight="Bold" VerticalAlignment="Top" Margin="0,8,0,0"/></DockPanel>
          <Border Style="{StaticResource Card}"><TextBlock Text="FIFA detections stay here until you import or dismiss them. Select a match to inspect the evidence, then open it in the editable match form." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></Border>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}"><ListBox ItemsSource="{Binding PendingMatchReviews}" SelectedItem="{Binding SelectedMatchReview}" MinHeight="330"><ListBox.ItemTemplate><DataTemplate><Grid Margin="4,9"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Score}" Foreground="{StaticResource Accent}" FontSize="20" FontWeight="Bold"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Opponent}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding Date}" Foreground="{StaticResource Muted}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding Confidence}" Foreground="{StaticResource Interactive}" FontSize="11" HorizontalAlignment="Right"/><TextBlock Text="{Binding Venue}" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
            <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="DETECTION EVIDENCE" Style="{StaticResource Label}"/><TextBlock Text="{Binding SelectedMatchReview.Opponent}" FontSize="24" FontWeight="Bold"/><TextBlock Text="{Binding SelectedReviewDetails}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,14"/><TextBlock Text="{Binding SelectedMatchReview.Captured}" FontSize="11"/><TextBlock Text="{Binding SelectedMatchReview.Source}" Foreground="{StaticResource Muted}" FontSize="11"/><Button Content="REVIEW AND EDIT" Click="OpenSelectedReview_Click" Margin="0,18,0,4"/><Button Content="DISMISS DETECTION" Click="DismissSelectedReview_Click" Style="{StaticResource SecondaryButton}"/></StackPanel></Border>
          </Grid>
        </StackPanel></ScrollViewer>

        <ScrollViewer x:Name="CareerPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="820" HorizontalAlignment="Left">
          <TextBlock Text="Career setup" Style="{StaticResource Heading}"/>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="AUTOMATIC FIFA 18 SYNC" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
            <TextBlock Text="Reads the newest Career save without modifying FIFA or its files." Foreground="{StaticResource Muted}" Margin="0,5,0,12"/>
            <TextBlock Text="Detected settings directory" Style="{StaticResource Label}"/><TextBlock Text="{Binding FifaSettingsDirectory}" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,4,0,10"/>
            <CheckBox Content="Watch for completed FIFA saves automatically" IsChecked="{Binding AutoFifaWatch}" Click="AutoFifaWatch_Click"/>
            <CheckBox Content="Synchronize FIFA teammates automatically" IsChecked="{Binding AutoFifaSquadSync}" Click="FifaPreference_Click" Margin="0,4,0,0"/>
            <Button Content="SCAN NEWEST FIFA SAVE" Click="ScanFifa_Click" Width="205" HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding FifaSyncStatus}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
            <TextBlock Text="Detected fixture history" Style="{StaticResource Label}" Margin="0,14,0,3"/>
            <ItemsControl ItemsSource="{Binding Fixtures}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,4"><TextBlock><Run Text="{Binding Date, Mode=OneWay}"/><Run Text=" | "/><Run Text="{Binding Opponent, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" | "/><Run Text="{Binding Competition, Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Create a new save" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><UniformGrid Columns="2"><StackPanel><TextBlock Text="Save name" Style="{StaticResource Label}"/><TextBox Text="{Binding NewSaveName,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Player name" Style="{StaticResource Label}"/><TextBox Text="{Binding NewPlayerName}"/><TextBlock Text="Nationality" Style="{StaticResource Label}"/><TextBox Text="{Binding NewNationality}"/><TextBlock Text="Age" Style="{StaticResource Label}"/><TextBox Text="{Binding NewAge}"/></StackPanel><StackPanel><TextBlock Text="Club" Style="{StaticResource Label}"/><TextBox Text="{Binding NewClub}"/><TextBlock Text="League / season" Style="{StaticResource Label}"/><StackPanel Orientation="Horizontal"><TextBox Width="180" Text="{Binding NewLeague}"/><TextBox Width="120" Text="{Binding NewSeason}"/></StackPanel><TextBlock Text="Position / shirt number" Style="{StaticResource Label}"/><StackPanel Orientation="Horizontal"><TextBox Width="180" Text="{Binding NewPosition}"/><TextBox Width="120" Text="{Binding NewShirtNumber}"/></StackPanel></StackPanel></UniformGrid><Button Content="CREATE CAREER" Click="CreateCareer_Click" Width="170" HorizontalAlignment="Left"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Your careers" FontSize="18" FontWeight="SemiBold"/><ListBox ItemsSource="{Binding Careers}" SelectedItem="{Binding CurrentCareer}" DisplayMemberPath="SaveName" Height="150"/><Button Content="OPEN SELECTED" Click="OpenCareer_Click" Width="160" HorizontalAlignment="Left"/></StackPanel></Border>
        </StackPanel></ScrollViewer>

        <ScrollViewer x:Name="MatchPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="1000" HorizontalAlignment="Left"><TextBlock Text="Match center" Style="{StaticResource Heading}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="LOG OR CORRECT A MATCH" Style="{StaticResource Label}"/><UniformGrid Columns="3"><StackPanel><TextBlock Text="Date" Style="{StaticResource Label}"/><TextBox Text="{Binding MatchDate}"/><TextBlock Text="Competition" Style="{StaticResource Label}"/><TextBox Text="{Binding MatchCompetition}"/><TextBlock Text="Opponent" Style="{StaticResource Label}"/><TextBox Text="{Binding MatchOpponent}"/><CheckBox Content="Home match" IsChecked="{Binding MatchHome}"/><CheckBox Content="International match" IsChecked="{Binding InternationalMatch}"/><TextBlock Text="Representing team" Style="{StaticResource Label}"/><TextBox Text="{Binding RepresentingTeam}"/></StackPanel><StackPanel><TextBlock Text="Score (us / them)" Style="{StaticResource Label}"/><StackPanel Orientation="Horizontal"><TextBox Width="80" Text="{Binding TeamScore}"/><TextBox Width="80" Text="{Binding OpponentScore}"/></StackPanel><TextBlock Text="FIFA confirmed the international result, but not the exact score. Enter it to import." Visibility="{Binding ScoreReviewVisibility}" Foreground="{StaticResource Warm}" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="Goals / assists" Style="{StaticResource Label}"/><StackPanel Orientation="Horizontal"><TextBox Width="80" Text="{Binding Goals}"/><TextBox Width="80" Text="{Binding Assists}"/></StackPanel><TextBlock Text="Rating / minutes" Style="{StaticResource Label}"/><StackPanel Orientation="Horizontal"><TextBox Width="80" Text="{Binding Rating}"/><TextBox Width="80" Text="{Binding Minutes}"/></StackPanel><CheckBox Content="Started" IsChecked="{Binding Started}"/><TextBlock Text="FIFA did not expose starter status. Change this box only if you know it." Visibility="{Binding StartedReviewVisibility}" Foreground="{StaticResource Warm}" FontSize="11" TextWrapping="Wrap"/></StackPanel><StackPanel><TextBlock Text="Next opponent" Style="{StaticResource Label}"/><TextBox Text="{Binding MatchNextOpponent}"/><CheckBox Content="Yellow card" IsChecked="{Binding YellowCard}"/><CheckBox Content="Red card" IsChecked="{Binding RedCard}"/><CheckBox Content="Penalty scored" IsChecked="{Binding PenaltyScored}"/><CheckBox Content="Penalty missed" IsChecked="{Binding PenaltyMissed}"/><CheckBox Content="Derby / rivalry" IsChecked="{Binding IsDerby}"/><CheckBox Content="Major fixture" IsChecked="{Binding IsMajor}"/></StackPanel></UniformGrid><TextBlock Text="Notable objective detail (e.g. 90+2 late winner)" Style="{StaticResource Label}"/><TextBox Text="{Binding MatchNotes}"/><WrapPanel><Button Content="{Binding MatchSubmitLabel}" Click="ProcessMatch_Click" Width="180"/><Button Content="CANCEL EDIT" Click="CancelMatchEdit_Click" Width="150" Style="{StaticResource SecondaryButton}" Visibility="{Binding MatchEditVisibility}"/></WrapPanel><TextBlock Text="{Binding MatchResultSummary}" TextWrapping="Wrap" Foreground="{StaticResource Accent}"/></StackPanel></Border><Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MATCH HISTORY" Style="{StaticResource Label}"/><ListBox ItemsSource="{Binding MatchHistory}" SelectedItem="{Binding SelectedLoggedMatch}" MinHeight="220"><ListBox.ItemTemplate><DataTemplate><Grid Margin="4,7"><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Input.Date}" Foreground="{StaticResource Muted}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Input.Opponent}" FontWeight="SemiBold"/><TextBlock Text="{Binding Input.TeamContext}" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel><TextBlock Grid.Column="2" HorizontalAlignment="Right"><Run Text="{Binding Input.TeamScore, Mode=OneWay}"/><Run Text="-"/><Run Text="{Binding Input.OpponentScore, Mode=OneWay}"/></TextBlock></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel><StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="SELECTED MATCH" Style="{StaticResource Label}"/><TextBlock Text="{Binding SelectedMatchHistoryDetails}" TextWrapping="Wrap" Margin="0,5,0,12"/><Button Content="EDIT MATCH" Click="EditMatch_Click"/><Button Content="DELETE MANUAL MATCH" Click="DeleteMatch_Click" Style="{StaticResource SecondaryButton}"/><TextBlock Text="FIFA synchronized matches can be corrected but cannot be deleted because they anchor automatic stat detection." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Grid></Border></StackPanel></ScrollViewer>

        <ScrollViewer x:Name="SquadPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
          <DockPanel><TextBlock Text="Squad" Style="{StaticResource Heading}"/><ComboBox DockPanel.Dock="Right" ItemsSource="{Binding SquadFilters}" SelectedItem="{Binding SelectedSquadFilter}" Width="170" VerticalAlignment="Top"/></DockPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ACTIVE FIRST TEAM" Style="{StaticResource Label}"/><ListBox ItemsSource="{Binding SquadMembers}" SelectedItem="{Binding SelectedSquadMember}" MinHeight="320" HorizontalContentAlignment="Stretch"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid Margin="3,7"><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/><ColumnDefinition Width="102"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ShirtLabel}" Foreground="{StaticResource Accent}" FontWeight="Bold"/><StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Position}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding OverallLabel}" FontWeight="SemiBold" HorizontalAlignment="Left"/><TextBlock Grid.Column="3" Text="{Binding Availability}" FontSize="11" HorizontalAlignment="Right"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Interactive}"/><Style.Triggers><DataTrigger Binding="{Binding Injured}" Value="True"><Setter Property="Foreground" Value="{StaticResource Danger}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
            <StackPanel Grid.Column="1"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PLAYER DETAIL" Style="{StaticResource Label}"/><TextBlock Text="{Binding SelectedSquadMember.Name}" FontSize="24" FontWeight="Bold"/><TextBlock Text="{Binding SelectedSquadFacts}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7"/><TextBlock Text="{Binding SelectedSquadRelationship}" Foreground="{StaticResource Accent}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="OTHER CHARACTERS" Style="{StaticResource Label}"/><ListBox ItemsSource="{Binding OtherCharacters}" SelectedItem="{Binding SelectedCharacter}" DisplayMemberPath="Name" MaxHeight="130"/></StackPanel></Border></StackPanel>
          </Grid>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="FORMER TEAMMATES" Style="{StaticResource Label}"/><ItemsControl ItemsSource="{Binding FormerTeammates}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,4"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" | "/><Run Text="{Binding Position, Mode=OneWay}"/><Run Text=" | "/><Run Text="{Binding OverallLabel, Mode=OneWay}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ADD A CHARACTER" Style="{StaticResource Label}"/><UniformGrid Columns="3"><StackPanel><TextBlock Text="Name" Style="{StaticResource Label}"/><TextBox Text="{Binding CharacterName}"/><TextBlock Text="Age" Style="{StaticResource Label}"/><TextBox Text="{Binding CharacterAge}"/></StackPanel><StackPanel><TextBlock Text="Nationality" Style="{StaticResource Label}"/><TextBox Text="{Binding CharacterNationality}"/><TextBlock Text="Position" Style="{StaticResource Label}"/><TextBox Text="{Binding CharacterPosition}"/></StackPanel><StackPanel><TextBlock Text="Role" Style="{StaticResource Label}"/><TextBox Text="{Binding CharacterRole}"/><TextBlock Text="Type" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding CharacterTypes}" SelectedItem="{Binding CharacterType}"/></StackPanel></UniformGrid><Button Content="ADD CHARACTER" Click="AddCharacter_Click" Width="170" HorizontalAlignment="Left"/></StackPanel></Border>
        </StackPanel></ScrollViewer>

        <ScrollViewer x:Name="MessagesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Messages" Style="{StaticResource Heading}"/>
            <TextBlock Text="{Binding MessageInboxSummary}" Foreground="{StaticResource Muted}" Margin="0,-10,0,12" TextWrapping="Wrap"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Conversation with" Style="{StaticResource Label}"/>
                <ComboBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}">
                  <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Your messages sit on the right. Replies sit on the left." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,10"/>
                <ItemsControl ItemsSource="{Binding Messages}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" MaxWidth="650" HorizontalAlignment="Left" CornerRadius="12" Padding="14,10">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="{StaticResource Panel2}"/>
                              <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
                              <Setter Property="BorderThickness" Value="1"/>
                              <Setter Property="TextElement.Foreground" Value="{StaticResource Text}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Role}" Value="user">
                                  <Setter Property="Grid.Column" Value="2"/>
                                  <Setter Property="HorizontalAlignment" Value="Right"/>
                                  <Setter Property="Background" Value="{StaticResource Interactive}"/>
                                  <Setter Property="BorderBrush" Value="{StaticResource Interactive}"/>
                                  <Setter Property="TextElement.Foreground" Value="{StaticResource Bg}"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <StackPanel>
                            <DockPanel LastChildFill="False">
                              <TextBlock Text="{Binding DisplayRole}" FontWeight="Bold" FontSize="11">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Role}" Value="user"><Setter Property="Foreground" Value="{StaticResource Bg}"/></DataTrigger></Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                              <TextBlock DockPanel.Dock="Right" Text="{Binding DisplayTimestamp}" FontSize="11" Margin="12,0,0,0">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Role}" Value="user"><Setter Property="Foreground" Value="{StaticResource Bg}"/></DataTrigger></Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </DockPanel>
                            <TextBlock Text="{Binding ConversationContext}" FontSize="10" Margin="0,2,0,0">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                  <Style.Triggers><DataTrigger Binding="{Binding Role}" Value="user"><Setter Property="Foreground" Value="{StaticResource Bg}"/></DataTrigger></Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ReplyContext}" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" Margin="0,6,0,0">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                  <Style.Triggers><DataTrigger Binding="{Binding Role}" Value="user"><Setter Property="Foreground" Value="{StaticResource Bg}"/></DataTrigger></Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Margin="0,5,0,0">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                  <Style.Triggers><DataTrigger Binding="{Binding Role}" Value="user"><Setter Property="Foreground" Value="{StaticResource Bg}"/></DataTrigger></Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </StackPanel>
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Write a new message" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                <TextBox Text="{Binding MessageText}" AcceptsReturn="True" MinHeight="70"/>
                <StackPanel Orientation="Horizontal"><ComboBox ItemsSource="{Binding SceneTypes}" SelectedItem="{Binding SelectedScene}" Width="210"/><Button Content="SEND" Click="SendMessage_Click" Width="110"/></StackPanel>
                <TextBlock Text="{Binding MessageGenerationStatus}" Foreground="{StaticResource Muted}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ManagerPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Manager office" Style="{StaticResource Heading}"/><Border Style="{StaticResource Card}" Background="{StaticResource Panel2}"><StackPanel><TextBlock Text="CURRENT MANAGER" Style="{StaticResource Label}"/><TextBlock Text="{Binding ManagerName}" FontSize="30" FontWeight="Bold"/><TextBlock Text="{Binding ManagerRelationship}" Foreground="{StaticResource Accent}" Margin="0,5,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="OFFICE BRIEFING" Style="{StaticResource Label}"/><TextBlock Text="{Binding ManagerBriefing}" FontSize="17" TextWrapping="Wrap" Margin="0,7,0,12"/><Button Content="REQUEST A MEETING" Click="TalkManager_Click" Width="190" HorizontalAlignment="Left"/><TextBlock Text="Touchline automatically adds the verified FIFA club manager and sends grounded reactions after important matches." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="REPRESENTATIVE" Style="{StaticResource Label}"/><TextBlock Text="{Binding AgentName}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Your FIFA agent is synchronized when the save exposes a name." Foreground="{StaticResource Muted}"/><Button Content="CONTACT AGENT" Click="TalkAgent_Click" Width="170" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}"/></StackPanel></Border></StackPanel></ScrollViewer>
        <ScrollViewer x:Name="PressPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Post-match interview" Style="{StaticResource Heading}"/>
          <Border Style="{StaticResource Card}" Visibility="{Binding InterviewVisibility}"><StackPanel><TextBlock Text="{Binding InterviewProgress}" Style="{StaticResource Label}"/><ItemsControl ItemsSource="{Binding InterviewTranscript}" Margin="0,5,0,12"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource Panel2}" Padding="10,7" Margin="0,3"><TextBlock Text="{Binding}" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding PressQuestion}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,18"/><TextBlock Text="Your answer" Style="{StaticResource Label}"/><TextBox Text="{Binding PressAnswer,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="110"/><WrapPanel><Button Content="SUBMIT ANSWER" Click="RecordPress_Click" Width="170"/><Button Content="DECLINE INTERVIEW" Click="DeclineInterview_Click" Width="180" Style="{StaticResource SecondaryButton}"/></WrapPanel><TextBlock Text="{Binding InterviewGenerationStatus}" Foreground="{StaticResource Interactive}"/><TextBlock Text="The journalist reacts to your answer and asks a grounded follow-up. Without an API key, an offline response is used." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Visibility="{Binding InterviewCompleteVisibility}"><StackPanel><TextBlock Text="{Binding InterviewCompletionText}" Foreground="{StaticResource Interactive}" FontSize="20" FontWeight="Bold"/><ItemsControl ItemsSource="{Binding InterviewTranscript}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource Panel2}" Padding="10,7" Margin="0,3"><TextBlock Text="{Binding}" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
          <Border Style="{StaticResource Card}" Visibility="{Binding NoInterviewVisibility}"><StackPanel><TextBlock Text="NO MEDIA DUTY" Foreground="{StaticResource Interactive}" FontWeight="Bold"/><TextBlock Text="{Binding PressQuestion}" FontSize="20" TextWrapping="Wrap" Margin="0,8,0,6"/><TextBlock Text="Interviews are reserved for exceptional performances, major fixtures, controversy, important streaks, and significant defeats." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
        <ScrollViewer x:Name="NewsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="News" Style="{StaticResource Heading}"/><ItemsControl ItemsSource="{Binding News}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="{Binding Outlet}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="{Binding PublishedAt,StringFormat={}{0:dd MMM yyyy}}" Foreground="{StaticResource Muted}" FontSize="11"/></DockPanel><TextBlock Text="{Binding Headline}" FontSize="20" FontWeight="SemiBold" Margin="0,4"/><TextBlock Text="{Binding Body}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
        <ScrollViewer x:Name="SocialPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Social" Style="{StaticResource Heading}"/><ItemsControl ItemsSource="{Binding Social}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="{Binding Author}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="{Binding PublishedAt,StringFormat={}{0:dd MMM yyyy}}" Foreground="{StaticResource Muted}" FontSize="11"/></DockPanel><TextBlock Text="{Binding Persona}" Style="{StaticResource Label}"/><TextBlock Text="{Binding Content}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
        <ScrollViewer x:Name="TimelinePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Career timeline" Style="{StaticResource Heading}"/><ItemsControl ItemsSource="{Binding Events}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Timestamp,StringFormat={}{0:dd MMM yyyy}}" Foreground="{StaticResource Muted}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Type}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Importance}" Foreground="{StaticResource Accent}" HorizontalAlignment="Right"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>

        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="780" HorizontalAlignment="Left"><TextBlock Text="Settings" Style="{StaticResource Heading}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="AI PROVIDER" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="API key (encrypted for this Windows user, leave blank for Ollama or local endpoints)" Style="{StaticResource Label}"/><PasswordBox x:Name="ApiKeyBox"/><TextBlock Text="Choose a model below. OpenRouter models automatically use https://openrouter.ai/api/v1. The endpoint is shown below so you can use another compatible service when needed. Premium routing uses the premium model for major events, but it stays on your OpenRouter model when the premium choice has no matching provider key." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/><TextBlock Text="Default / premium model" Style="{StaticResource Label}"/><StackPanel Orientation="Horizontal"><ComboBox Width="250" ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding DefaultModel,Mode=TwoWay}"/><ComboBox Width="250" Margin="8,0,0,0" ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding PremiumModel,Mode=TwoWay}"/></StackPanel><TextBlock Text="OpenAI-compatible endpoint" Style="{StaticResource Label}" Margin="0,10,0,0"/><TextBox Text="{Binding CompatibleEndpoint,UpdateSourceTrigger=PropertyChanged}" ToolTip="Examples: https://openrouter.ai/api/v1 or http://localhost:1234/v1"/><CheckBox Content="Use premium model for major events" IsChecked="{Binding PremiumRouting}"/><Button Content="SAVE LLM SETTINGS" Click="SaveSettings_Click" Width="190" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Generation" FontSize="18" FontWeight="SemiBold"/><CheckBox Content="Automatic teammate reactions" IsChecked="{Binding AutoTeammates}"/><CheckBox Content="Automatic manager reactions" IsChecked="{Binding AutoManager}"/><CheckBox Content="Automatic news" IsChecked="{Binding AutoNews}"/><CheckBox Content="Automatic social posts" IsChecked="{Binding AutoSocial}"/><CheckBox Content="Automatic press prompts" IsChecked="{Binding AutoPress}"/><CheckBox Content="Developer/debug mode" IsChecked="{Binding DebugMode}"/><Button Content="SAVE PREFERENCES" Click="SaveSettings_Click" Width="190" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Backup" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Creates a consistent portable SQLite backup of every career." Foreground="{StaticResource Muted}"/><Button Content="EXPORT BACKUP" Click="Backup_Click" Width="170" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel></ScrollViewer>
        <ScrollViewer x:Name="DebugPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Simulation inspector" Style="{StaticResource Heading}"/><Border Style="{StaticResource Card}"><TextBox Text="{Binding DebugText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" MinHeight="500" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Border></StackPanel></ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>

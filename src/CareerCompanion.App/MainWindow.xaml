<Window x:Class="CareerCompanion.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Touchline | Career Companion" Width="1320" Height="820" MinWidth="1050" MinHeight="680" WindowStartupLocation="CenterScreen">
  <Grid Background="{StaticResource Bg}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource Shadow}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
      <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0"><TextBlock Text="TOUCHLINE" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="CAREER WORLD" Style="{StaticResource Label}" Margin="0,2,0,8"/><StackPanel Orientation="Horizontal" Margin="0,0,0,20"><Border Width="68" Height="3" Background="{StaticResource Accent}"/><Border Width="32" Height="3" Background="{StaticResource Warm}"/><Border Width="18" Height="3" Background="{StaticResource Danger}"/></StackPanel></StackPanel>
        <ListBox Grid.Row="1" x:Name="Navigation" SelectionChanged="Navigation_Changed" SelectedIndex="0">
          <ListBox.Resources><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,1"/><Setter Property="FontWeight" Value="SemiBold"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource Panel2}"/><Setter Property="Foreground" Value="{StaticResource Interactive}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Panel}"/></Trigger></Style.Triggers></Style></ListBox.Resources>
          <ListBoxItem Content="HOME"/><ListBoxItem Content="PRE-MATCH"/><ListBoxItem Content="CAREER"/><ListBoxItem Content="MATCH"/><ListBoxItem Content="SQUAD"/><ListBoxItem Content="MESSAGES"/><ListBoxItem Content="MANAGER"/><ListBoxItem Content="PRESS"/><ListBoxItem Content="NEWS"/><ListBoxItem Content="SOCIAL"/><ListBoxItem Content="TIMELINE"/><ListBoxItem Content="SETTINGS"/><ListBoxItem Content="DEBUG" Visibility="{Binding DebugVisibility}"/>
        </ListBox>
        <StackPanel Grid.Row="2"><TextBlock Text="ACTIVE SAVE" Style="{StaticResource Label}"/><TextBlock Text="{Binding CurrentCareer.SaveName, FallbackValue=No career}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="28,22,20,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,14"><TextBlock Text="{Binding CurrentCareer.Club}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="RESTORE BACKUP" Click="Restore_Click" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,8,0"/><Button Content="EDIT SELECTED PROFILE" Click="EditProfile_Click" Padding="10,4" Margin="0,0,14,0"/><TextBlock Text="{Binding CurrentCareer.Season}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel></DockPanel>
      <Border Grid.Row="1" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="12,8" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="{StaticResource Interactive}" Padding="9,4" VerticalAlignment="Center"><TextBlock Text="{Binding FifaSyncBadge}" Foreground="{StaticResource Shadow}" FontWeight="Bold" FontSize="11"/></Border><StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="{Binding FifaSyncStatus}" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="{StaticResource Muted}" FontSize="11"><Run Text="{Binding LastFifaSyncText, Mode=OneWay}"/><Run Text=" | "/><Run Text="{Binding FifaSourceText, Mode=OneWay}"/></TextBlock></StackPanel><Button Grid.Column="2" Content="REVIEW MATCH" Click="ReviewFifaMatch_Click" Visibility="{Binding FifaReviewVisibility}" Padding="12,5" Margin="0"/></Grid></Border>
      <Grid Grid.Row="2">
        <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="Career briefing" Style="{StaticResource Heading}"/>
          <Border Style="{StaticResource Card}" Visibility="{Binding NoCareerVisibility}"><StackPanel><TextBlock Text="Start your football world" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Create a career in the Career section. LLM setup can wait; manual simulation works fully offline." Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
          <WrapPanel><Border Style="{StaticResource Card}" Width="330"><StackPanel><TextBlock Text="PLAYER" Style="{StaticResource Label}"/><TextBlock Text="{Binding CurrentCareer.PlayerName}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding PlayerSummary}" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="330"><StackPanel><TextBlock Text="RECENT MATCH" Style="{StaticResource Label}"/><TextBlock Text="{Binding RecentMatchSummary}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding CurrentForm}" Foreground="{StaticResource Accent}" Margin="0,4,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="330"><StackPanel><TextBlock Text="NEXT FIXTURE" Style="{StaticResource Label}"/><TextBlock Text="{Binding NextFixture}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Automatically read from FIFA previews" Foreground="{StaticResource Muted}"/></StackPanel></Border></WrapPanel>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="LATEST WORLD ACTIVITY" Style="{StaticResource Label}"/><ItemsControl ItemsSource="{Binding DashboardItems}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,9,0,0" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        </StackPanel></ScrollViewer>

        <ScrollViewer x:Name="PreMatchPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="Pre-match briefing" Style="{StaticResource Heading}"/>
          <Border Style="{StaticResource Card}" Background="{StaticResource Panel2}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="NEXT OPPONENT" Style="{StaticResource Label}"/><TextBlock Text="{Binding PreMatchOpponent}" FontSize="32" FontWeight="Bold"/><TextBlock Text="{Binding PreMatchMeta}" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="MATCHDAY" Foreground="{StaticResource Accent}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/></Grid></Border>
          <UniformGrid Columns="3"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="RECENT FORM" Style="{StaticResource Label}"/><TextBlock Text="{Binding PreMatchForm}" Foreground="{StaticResource Accent}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="AVAILABILITY" Style="{StaticResource Label}"/><TextBlock Text="{Binding PreMatchAvailability}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="KEY PLAYERS" Style="{StaticResource Label}"/><TextBlock Text="{Binding PreMatchKeyPlayers}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border></UniformGrid>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PREPARE" Style="{StaticResource Label}"/><TextBlock Text="Set the tone before kickoff. Conversations open with the fixture context already prepared." Foreground="{StaticResource Muted}" Margin="0,5,0,10"/><WrapPanel><Button Content="TALK TO TEAMMATE" Click="TalkTeammate_Click" Width="180"/><Button Content="TALK TO MANAGER" Click="TalkManager_Click" Width="180"/><Button Content="OPEN PRESS ROOM" Click="OpenPress_Click" Width="180" Style="{StaticResource SecondaryButton}"/></WrapPanel></StackPanel></Border>
        </StackPanel></ScrollViewer>

        <ScrollViewer x:Name="CareerPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="820" HorizontalAlignment="Left">
          <TextBlock Text="Career setup" Style="{StaticResource Heading}"/>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="AUTOMATIC FIFA 18 SYNC" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
            <TextBlock Text="Reads the newest Career save without modifying FIFA or its files." Foreground="{StaticResource Muted}" Margin="0,5,0,12"/>
            <TextBlock Text="Detected settings directory" Style="{StaticResource Label}"/><TextBlock Text="{Binding FifaSettingsDirectory}" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,4,0,10"/>
            <CheckBox Content="Watch for completed FIFA saves automatically" IsChecked="{Binding AutoFifaWatch}" Click="AutoFifaWatch_Click"/>
            <CheckBox Content="Synchronize FIFA teammates automatically" IsChecked="{Binding AutoFifaSquadSync}" Click="FifaPreference_Click" Margin="0,4,0,0"/>
            <Button Content="SCAN NEWEST FIFA SAVE" Click="ScanFifa_Click" Width="205" HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding FifaSyncStatus}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
            <TextBlock Text="Detected fixture history" Style="{StaticResource Label}" Margin="0,14,0,3"/>
            <ItemsControl ItemsSource="{Binding Fixtures}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,4"><TextBlock><Run Text="{Binding Date, Mode=OneWay}"/><Run Text=" | "/><Run Text="{Binding Opponent, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" | "/><Run Text="{Binding Competition, Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Create a new save" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><UniformGrid Columns="2"><StackPanel><TextBlock Text="Save name" Style="{StaticResource Label}"/><TextBox Text="{Binding NewSaveName,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Player name" Style="{StaticResource Label}"/><TextBox Text="{Binding NewPlayerName}"/><TextBlock Text="Nationality" Style="{StaticResource Label}"/><TextBox Text="{Binding NewNationality}"/><TextBlock Text="Age" Style="{StaticResource Label}"/><TextBox Text="{Binding NewAge}"/></StackPanel><StackPanel><TextBlock Text="Club" Style="{StaticResource Label}"/><TextBox Text="{Binding NewClub}"/><TextBlock Text="League / season" Style="{StaticResource Label}"/><StackPanel Orientation="Horizontal"><TextBox Width="180" Text="{Binding NewLeague}"/><TextBox Width="120" Text="{Binding NewSeason}"/></StackPanel><TextBlock Text="Position / shirt number" Style="{StaticResource Label}"/><StackPanel Orientation="Horizontal"><TextBox Width="180" Text="{Binding NewPosition}"/><TextBox Width="120" Text="{Binding NewShirtNumber}"/></StackPanel></StackPanel></UniformGrid><Button Content="CREATE CAREER" Click="CreateCareer_Click" Width="170" HorizontalAlignment="Left"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Your careers" FontSize="18" FontWeight="SemiBold"/><ListBox ItemsSource="{Binding Careers}" SelectedItem="{Binding CurrentCareer}" DisplayMemberPath="SaveName" Height="150"/><Button Content="OPEN SELECTED" Click="OpenCareer_Click" Width="160" HorizontalAlignment="Left"/></StackPanel></Border>
        </StackPanel></ScrollViewer>

        <ScrollViewer x:Name="MatchPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="900" HorizontalAlignment="Left"><TextBlock Text="Log a match" Style="{StaticResource Heading}"/><Border Style="{StaticResource Card}"><StackPanel><UniformGrid Columns="3"><StackPanel><TextBlock Text="Date" Style="{StaticResource Label}"/><TextBox Text="{Binding MatchDate}"/><TextBlock Text="Competition" Style="{StaticResource Label}"/><TextBox Text="{Binding MatchCompetition}"/><TextBlock Text="Opponent" Style="{StaticResource Label}"/><TextBox Text="{Binding MatchOpponent}"/><CheckBox Content="Home match" IsChecked="{Binding MatchHome}"/></StackPanel><StackPanel><TextBlock Text="Score (us / them)" Style="{StaticResource Label}"/><StackPanel Orientation="Horizontal"><TextBox Width="80" Text="{Binding TeamScore}"/><TextBox Width="80" Text="{Binding OpponentScore}"/></StackPanel><TextBlock Text="Goals / assists" Style="{StaticResource Label}"/><StackPanel Orientation="Horizontal"><TextBox Width="80" Text="{Binding Goals}"/><TextBox Width="80" Text="{Binding Assists}"/></StackPanel><TextBlock Text="Rating / minutes" Style="{StaticResource Label}"/><StackPanel Orientation="Horizontal"><TextBox Width="80" Text="{Binding Rating}"/><TextBox Width="80" Text="{Binding Minutes}"/></StackPanel><CheckBox Content="Started" IsChecked="{Binding Started}"/></StackPanel><StackPanel><TextBlock Text="Next opponent" Style="{StaticResource Label}"/><TextBox Text="{Binding MatchNextOpponent}"/><CheckBox Content="Yellow card" IsChecked="{Binding YellowCard}"/><CheckBox Content="Red card" IsChecked="{Binding RedCard}"/><CheckBox Content="Penalty scored" IsChecked="{Binding PenaltyScored}"/><CheckBox Content="Penalty missed" IsChecked="{Binding PenaltyMissed}"/><CheckBox Content="Derby / rivalry" IsChecked="{Binding IsDerby}"/><CheckBox Content="Major fixture" IsChecked="{Binding IsMajor}"/></StackPanel></UniformGrid><TextBlock Text="Notable objective detail (e.g. 90+2 late winner)" Style="{StaticResource Label}"/><TextBox Text="{Binding MatchNotes}"/><Button Content="PROCESS MATCH" Click="ProcessMatch_Click" Width="170" HorizontalAlignment="Left"/><TextBlock Text="{Binding MatchResultSummary}" TextWrapping="Wrap" Foreground="{StaticResource Accent}"/></StackPanel></Border></StackPanel></ScrollViewer>

        <ScrollViewer x:Name="SquadPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
          <DockPanel><TextBlock Text="Squad" Style="{StaticResource Heading}"/><ComboBox DockPanel.Dock="Right" ItemsSource="{Binding SquadFilters}" SelectedItem="{Binding SelectedSquadFilter}" Width="170" VerticalAlignment="Top"/></DockPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ACTIVE FIRST TEAM" Style="{StaticResource Label}"/><ListBox ItemsSource="{Binding SquadMembers}" SelectedItem="{Binding SelectedSquadMember}" MinHeight="320"><ListBox.ItemTemplate><DataTemplate><Grid Margin="3,7"><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ShirtLabel}" Foreground="{StaticResource Accent}" FontWeight="Bold"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Position}" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding OverallLabel}" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="{Binding Availability}" Foreground="{StaticResource Interactive}" FontSize="11" HorizontalAlignment="Right"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
            <StackPanel Grid.Column="1"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PLAYER DETAIL" Style="{StaticResource Label}"/><TextBlock Text="{Binding SelectedSquadMember.Name}" FontSize="24" FontWeight="Bold"/><TextBlock Text="{Binding SelectedSquadFacts}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7"/><TextBlock Text="{Binding SelectedRelationship}" Foreground="{StaticResource Accent}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="OTHER CHARACTERS" Style="{StaticResource Label}"/><ListBox ItemsSource="{Binding OtherCharacters}" SelectedItem="{Binding SelectedCharacter}" DisplayMemberPath="Name" MaxHeight="130"/></StackPanel></Border></StackPanel>
          </Grid>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="FORMER TEAMMATES" Style="{StaticResource Label}"/><ItemsControl ItemsSource="{Binding FormerTeammates}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,4"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" | "/><Run Text="{Binding Position, Mode=OneWay}"/><Run Text=" | "/><Run Text="{Binding OverallLabel, Mode=OneWay}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ADD A CHARACTER" Style="{StaticResource Label}"/><UniformGrid Columns="3"><StackPanel><TextBlock Text="Name" Style="{StaticResource Label}"/><TextBox Text="{Binding CharacterName}"/><TextBlock Text="Age" Style="{StaticResource Label}"/><TextBox Text="{Binding CharacterAge}"/></StackPanel><StackPanel><TextBlock Text="Nationality" Style="{StaticResource Label}"/><TextBox Text="{Binding CharacterNationality}"/><TextBlock Text="Position" Style="{StaticResource Label}"/><TextBox Text="{Binding CharacterPosition}"/></StackPanel><StackPanel><TextBlock Text="Role" Style="{StaticResource Label}"/><TextBox Text="{Binding CharacterRole}"/><TextBlock Text="Type" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding CharacterTypes}" SelectedItem="{Binding CharacterType}"/></StackPanel></UniformGrid><Button Content="ADD CHARACTER" Click="AddCharacter_Click" Width="170" HorizontalAlignment="Left"/></StackPanel></Border>
        </StackPanel></ScrollViewer>

        <ScrollViewer x:Name="MessagesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Messages" Style="{StaticResource Heading}"/><Border Style="{StaticResource Card}"><StackPanel><ComboBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}" DisplayMemberPath="Name"/><ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="12" Margin="0,4"><StackPanel><TextBlock Text="{Binding Role}" Foreground="{StaticResource Accent}" FontSize="11"/><TextBlock Text="{Binding Content}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBox Text="{Binding MessageText}" AcceptsReturn="True" MinHeight="70"/><StackPanel Orientation="Horizontal"><ComboBox ItemsSource="{Binding SceneTypes}" SelectedItem="{Binding SelectedScene}" Width="210"/><Button Content="SEND" Click="SendMessage_Click" Width="110"/></StackPanel><TextBlock Text="{Binding GenerationStatus}" Foreground="{StaticResource Muted}"/></StackPanel></Border></StackPanel></ScrollViewer>

        <ScrollViewer x:Name="ManagerPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Manager office" Style="{StaticResource Heading}"/><Border Style="{StaticResource Card}"><TextBlock Text="Manager conversations use selection, performance, discipline, morale and squad-role context. Add a Manager character in Squad, select them, then use Messages with the Manager Office scene." TextWrapping="Wrap"/></Border></StackPanel></ScrollViewer>
        <ScrollViewer x:Name="PressPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Press room" Style="{StaticResource Heading}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Contextual question" Style="{StaticResource Label}"/><TextBlock Text="{Binding PressQuestion}" FontSize="19" TextWrapping="Wrap" Margin="0,8,0,16"/><TextBox Text="{Binding PressAnswer}" AcceptsReturn="True" Height="100"/><Button Content="RECORD STATEMENT" Click="RecordPress_Click" Width="190"/><TextBlock Text="Public statements are persisted as save-specific memories and can shape future context." Foreground="{StaticResource Muted}"/></StackPanel></Border></StackPanel></ScrollViewer>
        <ScrollViewer x:Name="NewsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="News" Style="{StaticResource Heading}"/><ItemsControl ItemsSource="{Binding News}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Outlet}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/><TextBlock Text="{Binding Headline}" FontSize="20" FontWeight="SemiBold" Margin="0,4"/><TextBlock Text="{Binding Body}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
        <ScrollViewer x:Name="SocialPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Social" Style="{StaticResource Heading}"/><ItemsControl ItemsSource="{Binding Social}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Author}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/><TextBlock Text="{Binding Persona}" Style="{StaticResource Label}"/><TextBlock Text="{Binding Content}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
        <ScrollViewer x:Name="TimelinePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Career timeline" Style="{StaticResource Heading}"/><ItemsControl ItemsSource="{Binding Events}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Timestamp,StringFormat={}{0:dd MMM yyyy}}" Foreground="{StaticResource Muted}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Type}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Importance}" Foreground="{StaticResource Accent}" HorizontalAlignment="Right"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>

        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="780" HorizontalAlignment="Left"><TextBlock Text="Settings" Style="{StaticResource Heading}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="OpenAI" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="API key (encrypted for this Windows user)" Style="{StaticResource Label}"/><PasswordBox x:Name="ApiKeyBox"/><TextBlock Text="Default / premium model" Style="{StaticResource Label}"/><StackPanel Orientation="Horizontal"><TextBox Width="230" Text="{Binding DefaultModel}"/><TextBox Width="230" Text="{Binding PremiumModel}"/></StackPanel><CheckBox Content="Use premium model for major events" IsChecked="{Binding PremiumRouting}"/><Button Content="SAVE LLM SETTINGS" Click="SaveSettings_Click" Width="190" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Generation" FontSize="18" FontWeight="SemiBold"/><CheckBox Content="Automatic teammate reactions" IsChecked="{Binding AutoTeammates}"/><CheckBox Content="Automatic manager reactions" IsChecked="{Binding AutoManager}"/><CheckBox Content="Automatic news" IsChecked="{Binding AutoNews}"/><CheckBox Content="Automatic social posts" IsChecked="{Binding AutoSocial}"/><CheckBox Content="Automatic press prompts" IsChecked="{Binding AutoPress}"/><CheckBox Content="Developer/debug mode" IsChecked="{Binding DebugMode}"/><Button Content="SAVE PREFERENCES" Click="SaveSettings_Click" Width="190" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Backup" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Creates a consistent portable SQLite backup of every career." Foreground="{StaticResource Muted}"/><Button Content="EXPORT BACKUP" Click="Backup_Click" Width="170" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel></ScrollViewer>
        <ScrollViewer x:Name="DebugPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Simulation inspector" Style="{StaticResource Heading}"/><Border Style="{StaticResource Card}"><TextBox Text="{Binding DebugText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" MinHeight="500" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Border></StackPanel></ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>

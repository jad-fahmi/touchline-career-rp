<Window x:Class="CareerCompanion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:CareerCompanion.App"
        Title="Touchline | Career Companion"
        Width="1440" Height="900" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" Style="{StaticResource AppWindow}">

  <Window.Resources>

    <!-- Shared page furniture -->

    <!-- A form guide pill: W in green, D in grey, L in red. -->
    <DataTemplate x:Key="FormPillTemplate">
      <Border Width="26" Height="26" CornerRadius="13" Margin="0,0,6,0" Background="{Binding Fill}">
        <TextBlock Text="{Binding Letter}" Foreground="{Binding Ink}" FontWeight="Bold" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="RowPanel">
      <StackPanel Orientation="Horizontal"/>
    </ItemsPanelTemplate>

    <!-- One line of the wellbeing readout. -->
    <Style x:Key="MeterLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>

    <Style x:Key="MeterValue" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Nothing-to-show state. Quiet, never an error. -->
    <Style x:Key="EmptyState" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
      <Setter Property="Padding" Value="26"/>
    </Style>

    <!-- Sidebar group heading. A ListBox item so it sits in the flow, but never selectable. -->
    <Style x:Key="NavSection" TargetType="ListBoxItem">
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource Label}"
                       Margin="12,18,0,6"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Chat bubble text. The player's own bubble is lime, so its ink has to flip with it, and
         the app-wide TextBlock style beats plain inheritance - hence an explicit trigger. -->
    <Style x:Key="BubbleText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Role}" Value="user">
          <Setter Property="Foreground" Value="#141034"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="BubbleMeta" TargetType="TextBlock" BasedOn="{StaticResource BubbleText}">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Opacity" Value="0.72"/>
    </Style>

  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ===================================================================================
         Sidebar
         =================================================================================== -->
    <Border Background="{StaticResource SidebarFill}" BorderBrush="{StaticResource Stroke}"
            BorderThickness="0,0,1,0">
      <Grid Margin="14,18,14,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="8,0,8,14">
          <TextBlock Text="TOUCHLINE" FontFamily="{StaticResource DisplayFont}" FontSize="21"
                     FontWeight="Bold" Foreground="{StaticResource Accent}"/>
          <TextBlock Text="CAREER WORLD" Style="{StaticResource Caption}" Margin="0,1,0,10"/>
          <Border Height="3" CornerRadius="2" Background="{StaticResource BrandRule}" Width="118"
                  HorizontalAlignment="Left"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
          <ListBox x:Name="Navigation" SelectionChanged="Navigation_Changed" SelectedIndex="0"
                   ItemContainerStyle="{StaticResource NavItem}" Background="Transparent"
                   KeyboardNavigation.DirectionalNavigation="Cycle">

            <ListBoxItem Tag="Home" AutomationProperties.Name="Home" ToolTip="Career briefing (Ctrl+1)">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                <TextBlock Grid.Column="1" Text="Home" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
              </Grid>
            </ListBoxItem>

            <ListBoxItem Tag="WorldInbox" AutomationProperties.Name="World updates" ToolTip="Everything the world did since you last looked (Ctrl+2)">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7E7;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                <TextBlock Grid.Column="1" Text="World updates" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Border Grid.Column="2" Style="{StaticResource Badge}" Visibility="{Binding UnreadNotificationBadgeVisibility}">
                  <TextBlock Text="{Binding UnreadNotificationCount}" Foreground="{StaticResource Text}"
                             FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>
            </ListBoxItem>

            <ListBoxItem Tag="PreMatch" AutomationProperties.Name="Pre-match briefing" ToolTip="Opposition, availability, and the briefing before kickoff (Ctrl+3)">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE916;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                <TextBlock Grid.Column="1" Text="Pre-match" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
              </Grid>
            </ListBoxItem>

            <ListBoxItem Tag="ReviewInbox" AutomationProperties.Name="Review inbox" ToolTip="Only the results FIFA left ambiguous (Ctrl+4)">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                <TextBlock Grid.Column="1" Text="Review inbox" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Border Grid.Column="2" Style="{StaticResource Badge}" Background="{StaticResource Warm}"
                        Visibility="{Binding PendingMatchReviews.Count, Converter={StaticResource Empty}, ConverterParameter=Invert}">
                  <TextBlock Text="{Binding PendingMatchReviews.Count}" Foreground="#141034"
                             FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>
            </ListBoxItem>

            <ListBoxItem Style="{StaticResource NavSection}" Content="WORLD"/>

            <ListBoxItem Tag="Squad" AutomationProperties.Name="Squad" ToolTip="The dressing room as the save describes it (Ctrl+5)">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE716;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                <TextBlock Grid.Column="1" Text="Squad" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
              </Grid>
            </ListBoxItem>

            <ListBoxItem Tag="Messages" AutomationProperties.Name="Messages" ToolTip="Conversations with everyone in your world (Ctrl+6)">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8BD;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                <TextBlock Grid.Column="1" Text="Messages" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Border Grid.Column="2" Style="{StaticResource Badge}" Visibility="{Binding UnreadMessageBadgeVisibility}">
                  <TextBlock Text="{Binding UnreadMessageCount}" Foreground="{StaticResource Text}"
                             FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>
            </ListBoxItem>

            <ListBoxItem Tag="Manager" AutomationProperties.Name="Manager office" ToolTip="The manager's office and your representative (Ctrl+7)">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                <TextBlock Grid.Column="1" Text="Manager" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
              </Grid>
            </ListBoxItem>

            <ListBoxItem Tag="Press" AutomationProperties.Name="Press room" ToolTip="Post-match interviews (Ctrl+8)">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                <TextBlock Grid.Column="1" Text="Press room" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
              </Grid>
            </ListBoxItem>

            <ListBoxItem Tag="News" AutomationProperties.Name="News" ToolTip="Coverage of your career (Ctrl+9)">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                <TextBlock Grid.Column="1" Text="News" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
              </Grid>
            </ListBoxItem>

            <ListBoxItem Tag="Social" AutomationProperties.Name="Social" ToolTip="What the timeline is saying">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                <TextBlock Grid.Column="1" Text="Social" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
              </Grid>
            </ListBoxItem>

            <ListBoxItem Tag="Timeline" AutomationProperties.Name="Career timeline" ToolTip="Everything that has happened, in order">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                <TextBlock Grid.Column="1" Text="Timeline" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
              </Grid>
            </ListBoxItem>

            <ListBoxItem Style="{StaticResource NavSection}" Content="MANAGE"/>

            <ListBoxItem Tag="Match" AutomationProperties.Name="Match centre" ToolTip="Log or correct a match by hand">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7C1;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                <TextBlock Grid.Column="1" Text="Match centre" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
              </Grid>
            </ListBoxItem>

            <ListBoxItem Tag="Career" AutomationProperties.Name="Career setup" ToolTip="Saves, FIFA synchronization, and career creation">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE787;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                <TextBlock Grid.Column="1" Text="Career setup" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
              </Grid>
            </ListBoxItem>

            <ListBoxItem Tag="Settings" AutomationProperties.Name="Settings" ToolTip="Model, generation, and backup settings">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                <TextBlock Grid.Column="1" Text="Settings" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
              </Grid>
            </ListBoxItem>

            <ListBoxItem Tag="Debug" AutomationProperties.Name="Simulation inspector" Visibility="{Binding DebugVisibility}" ToolTip="Simulation inspector">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE71E;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                <TextBlock Grid.Column="1" Text="Inspector" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
              </Grid>
            </ListBoxItem>

          </ListBox>
        </ScrollViewer>

        <!-- Active save and the last thing that happened -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}"
                BorderThickness="1" CornerRadius="7" Padding="12,10" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="ACTIVE SAVE" Style="{StaticResource Label}" Margin="0,0,0,3"/>
            <TextBlock Text="{Binding CurrentCareer.SaveName, FallbackValue=No career open}"
                       FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
            <Border Height="1" Background="{StaticResource Stroke}" Margin="0,9"/>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="6" Height="6" Fill="{StaticResource Interactive}" VerticalAlignment="Top" Margin="0,6,7,0"/>
              <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Foreground="{StaticResource Muted}"
                         Width="176"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- ===================================================================================
         Content
         =================================================================================== -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Header: which career you are in, and the actions that apply everywhere -->
      <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}"
              BorderThickness="0,0,0,1" Padding="24,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <ComboBox Grid.Column="0" Width="230" Margin="0" VerticalAlignment="Center"
                    ItemsSource="{Binding Careers}" SelectedItem="{Binding CurrentCareer}"
                    ToolTip="Switch career save">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding SaveName}" TextTrimming="CharacterEllipsis"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding CurrentCareer.PlayerName, FallbackValue=No player}"
                       FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding CareerIdentity}" Style="{StaticResource Caption}"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding BusyMessage}" Style="{StaticResource Caption}"
                       Foreground="{StaticResource Interactive}" VerticalAlignment="Center"
                       Margin="0,0,12,0" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
            <Button Style="{StaticResource IconButton}" Click="OpenPalette_Click" AutomationProperties.Name="Go to anything"
                    ToolTip="Go to anything (Ctrl+K)">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;"/>
            </Button>
            <Button Style="{StaticResource IconButton}" Click="ScanFifa_Click" Margin="0,0,10,0" AutomationProperties.Name="Scan the newest FIFA save"
                    ToolTip="Scan the newest FIFA 18 save now (F5)">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;"/>
            </Button>
            <Button Content="EDIT PROFILE" Style="{StaticResource GhostButton}" Click="EditProfile_Click"
                    ToolTip="Edit the selected character's profile" Margin="0"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Sync strip: always answerable question "is Touchline seeing my save?" -->
      <Border Grid.Row="1" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Stroke}"
              BorderThickness="0,0,0,1" Padding="24,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Background="{StaticResource Interactive}" CornerRadius="4" Padding="9,4" VerticalAlignment="Center">
            <TextBlock Text="{Binding FifaSyncBadge}" Foreground="#141034" FontWeight="Bold" FontSize="11"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding FifaSyncStatus}" TextTrimming="CharacterEllipsis" FontSize="13"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
              <Run Text="{Binding LastFifaSyncText, Mode=OneWay}"/>
              <Run Text="  ·  " Foreground="{StaticResource Stroke}"/>
              <Run Text="{Binding FifaSourceText, Mode=OneWay}"/>
            </TextBlock>
          </StackPanel>
          <Button Grid.Column="2" Content="REVIEW MATCH" Click="ReviewFifaMatch_Click" Margin="0"
                  Visibility="{Binding FifaReviewVisibility}"/>
        </Grid>
      </Border>

      <ProgressBar Grid.Row="2" Style="{StaticResource BusyBar}" Visibility="{Binding BusyVisibility}"/>

      <!-- Page host -->
      <Grid Grid.Row="3" x:Name="PageHost" Margin="24,18,18,18">

        <!-- ============================== HOME ============================== -->
        <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Career briefing" Style="{StaticResource Heading}"/>
            <TextBlock Text="Everything Touchline read from your save, and everything the world did about it."
                       Style="{StaticResource Subheading}"/>

            <Border Style="{StaticResource EmptyState}"
                    Visibility="{Binding HasCareer, Converter={StaticResource Bool}, ConverterParameter=Invert}">
              <StackPanel>
                <TextBlock Text="Start your football world" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="Open Career setup to link a FIFA 18 save or create one by hand. A model key can wait - the whole simulation runs offline."
                           Style="{StaticResource BodyMuted}" Margin="0,8,0,14"/>
                <Button Content="OPEN CAREER SETUP" Click="GoCareer_Click" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>

            <!-- Hero: who you are, how it is going, what is next -->
            <Border Style="{StaticResource HeroCard}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="PLAYER" Style="{StaticResource Label}"/>
                  <TextBlock Text="{Binding CurrentCareer.PlayerName, FallbackValue=No career}" Style="{StaticResource Metric}"/>
                  <TextBlock Text="{Binding PlayerSummary}" Style="{StaticResource BodyMuted}" Margin="0,6,0,0"/>
                  <TextBlock Text="{Binding InternationalSummary}" Foreground="{StaticResource Interactive}"
                             FontSize="13" Margin="0,4,0,0"/>
                  <TextBlock Text="RECENT FORM" Style="{StaticResource Label}" Margin="0,18,0,8"/>
                  <ItemsControl ItemsSource="{Binding CurrentForm, Converter={StaticResource FormPills}}"
                                ItemTemplate="{StaticResource FormPillTemplate}"
                                ItemsPanel="{StaticResource RowPanel}"/>
                  <TextBlock Text="No matches logged yet." Style="{StaticResource Caption}" Margin="0,2,0,0"
                             Visibility="{Binding HasForm, Converter={StaticResource Bool}, ConverterParameter=Invert}"/>
                </StackPanel>

                <Border Grid.Column="1" Background="{StaticResource Sidebar}" CornerRadius="7" Padding="18"
                        MinWidth="330" MaxWidth="430" Margin="24,0,0,0">
                  <StackPanel>
                    <TextBlock Text="NEXT FIXTURE" Style="{StaticResource Label}"/>
                    <TextBlock Text="{Binding NextFixture}" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="Read automatically from FIFA previews." Style="{StaticResource Caption}" Margin="0,8,0,14"/>
                    <Button Content="OPEN PRE-MATCH BRIEFING" Click="GoPreMatch_Click" HorizontalAlignment="Left" Margin="0"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <!-- Match report and wellbeing sit side by side: the result, and what it cost you -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="2*"/>
              </Grid.ColumnDefinitions>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="MATCH REPORT" Style="{StaticResource Label}"/>
                  <TextBlock Text="{Binding LatestMatchTitle}" Style="{StaticResource Metric}" FontSize="26"/>
                  <TextBlock Text="{Binding LatestMatchContext}" Foreground="{StaticResource Accent}"
                             FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0"/>
                  <TextBlock Text="{Binding LatestMatchLine}" Style="{StaticResource BodyMuted}" Margin="0,8,0,0"/>

                  <StackPanel Visibility="{Binding LatestMatchSquadVisibility}">
                    <TextBlock Text="HOW THE SIDE PLAYED" Style="{StaticResource Label}" Margin="0,18,0,4"/>
                    <Grid Margin="0,0,0,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="78"/><ColumnDefinition Width="56"/><ColumnDefinition Width="48"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="PLAYER" Style="{StaticResource Caption}"/>
                      <TextBlock Grid.Column="1" Text="POS" Style="{StaticResource Caption}"/>
                      <TextBlock Grid.Column="2" Text="ROLE" Style="{StaticResource Caption}"/>
                      <TextBlock Grid.Column="3" Text="MINS" Style="{StaticResource Caption}"/>
                      <TextBlock Grid.Column="4" Text="RTG" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding LatestMatchSquad}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="Transparent" Padding="0,5" >
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="78"/><ColumnDefinition Width="56"/><ColumnDefinition Width="48"/>
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Grid.Column="1" Text="{Binding Position}" Style="{StaticResource Caption}" Foreground="{StaticResource Muted}"/>
                              <TextBlock Grid.Column="2" Text="{Binding Role}" Style="{StaticResource Caption}" Foreground="{StaticResource Muted}"/>
                              <TextBlock Grid.Column="3" Text="{Binding Minutes}" Style="{StaticResource Caption}" Foreground="{StaticResource Muted}"/>
                              <TextBlock Grid.Column="4" Text="{Binding Rating}" FontWeight="Bold" FontSize="13"
                                         HorizontalAlignment="Right"
                                         Foreground="{Binding Rating, Converter={StaticResource RatingBrush}}"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource CardRaised}">
                <StackPanel>
                  <TextBlock Text="PLAYER WELLBEING" Style="{StaticResource Label}"/>
                  <TextBlock Text="{Binding PlayerMindsetTitle}" Style="{StaticResource MetricSmall}"
                             Foreground="{StaticResource Accent}"/>
                  <TextBlock Text="{Binding PlayerMindsetDetail}" Style="{StaticResource BodyMuted}" Margin="0,6,0,14"/>

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Confidence" Style="{StaticResource MeterLabel}"/>
                    <ProgressBar Grid.Column="1" Value="{Binding Confidence, Mode=OneWay}" Margin="0,0,0,0"
                                 Foreground="{StaticResource Win}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Confidence}" Style="{StaticResource MeterValue}"/>

                    <TextBlock Grid.Row="1" Text="Pressure" Style="{StaticResource MeterLabel}" Margin="0,10,0,0"/>
                    <ProgressBar Grid.Row="1" Grid.Column="1" Value="{Binding Pressure, Mode=OneWay}" Margin="0,10,0,0"
                                 Foreground="{StaticResource Warm}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Pressure}" Style="{StaticResource MeterValue}" Margin="0,10,0,0"/>

                    <TextBlock Grid.Row="2" Text="Fatigue" Style="{StaticResource MeterLabel}" Margin="0,10,0,0"/>
                    <ProgressBar Grid.Row="2" Grid.Column="1" Value="{Binding Fatigue, Mode=OneWay}" Margin="0,10,0,0"
                                 Foreground="{StaticResource Danger}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Fatigue}" Style="{StaticResource MeterValue}" Margin="0,10,0,0"/>

                    <TextBlock Grid.Row="3" Text="Isolation" Style="{StaticResource MeterLabel}" Margin="0,10,0,0"/>
                    <ProgressBar Grid.Row="3" Grid.Column="1" Value="{Binding Isolation, Mode=OneWay}" Margin="0,10,0,0"
                                 Foreground="{StaticResource Draw}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Isolation}" Style="{StaticResource MeterValue}" Margin="0,10,0,0"/>
                  </Grid>

                  <StackPanel Visibility="{Binding RecoveryChoiceVisibility}" Margin="0,18,0,0">
                    <TextBlock Text="HOW DO YOU RESPOND?" Style="{StaticResource Label}"/>
                    <Button Content="OPEN UP TO SOMEONE" Click="OpenUp_Click" HorizontalAlignment="Stretch" Margin="0,0,0,7"/>
                    <Button Content="RECOVERY DAY" Click="RecoveryDay_Click" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Stretch" Margin="0,0,0,7"/>
                    <Button Content="TRAINING RESET" Click="TrainingReset_Click" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Stretch" Margin="0"/>
                    <TextBlock Text="One response per match. It changes how pressure, confidence, fatigue, and isolation carry into the next fixture."
                               Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Border Style="{StaticResource CardInteractive}" MouseLeftButtonUp="GoMessages_Click" Cursor="Hand">
                <StackPanel>
                  <TextBlock Text="INCOMING" Style="{StaticResource Label}"/>
                  <TextBlock Text="{Binding NotificationBadge}" Foreground="{StaticResource Interactive}"
                             FontWeight="Bold" FontSize="13"/>
                  <TextBlock Text="{Binding LatestIncoming}" Style="{StaticResource Body}" Margin="0,7,0,0"/>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource CardInteractive}" MouseLeftButtonUp="GoNews_Click" Cursor="Hand">
                <StackPanel>
                  <TextBlock Text="LATEST HEADLINE" Style="{StaticResource Label}"/>
                  <TextBlock Text="{Binding LatestHeadline}" Style="{StaticResource CardTitle}"/>
                  <TextBlock Style="{StaticResource Caption}" Margin="0,7,0,0">
                    <Run Text="Manager:"/>
                    <Run Text="{Binding ManagerName, Mode=OneWay}" Foreground="{StaticResource Muted}"/>
                  </TextBlock>
                </StackPanel>
              </Border>
            </Grid>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="LATEST WORLD ACTIVITY" Style="{StaticResource Label}"/>
                <ItemsControl ItemsSource="{Binding DashboardItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="5" Height="5" Fill="{StaticResource Accent}" VerticalAlignment="Top"
                                 Margin="0,7,10,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Body}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ============================== WORLD UPDATES ============================== -->
        <ScrollViewer x:Name="WorldInboxPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="World updates" Style="{StaticResource Heading}"/>
                <TextBlock Text="{Binding NotificationBadge}" Style="{StaticResource Subheading}"
                           Foreground="{StaticResource Interactive}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="MARK ALL READ" Click="MarkWorldRead_Click" Style="{StaticResource SecondaryButton}"/>
                <Button Content="CLEAR READ" Click="ClearWorldRead_Click" Style="{StaticResource GhostButton}" Margin="0"/>
              </StackPanel>
            </Grid>

            <Border Style="{StaticResource CardRaised}">
              <StackPanel>
                <TextBlock Text="CAREER PROGRESSION" Style="{StaticResource Label}"/>
                <TextBlock Text="{Binding ProgressSummary}" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="Captured automatically from each distinct FIFA save snapshot."
                           Style="{StaticResource Caption}" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource EmptyState}"
                    Visibility="{Binding Notifications.Count, Converter={StaticResource Empty}}">
              <StackPanel>
                <TextBlock Text="Nothing has happened yet" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="Play a match in FIFA 18. Touchline reads the save and the world reacts on its own."
                           Style="{StaticResource BodyMuted}" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>

            <ListBox ItemsSource="{Binding Notifications}" SelectedItem="{Binding SelectedNotification}"
                     ItemContainerStyle="{StaticResource CardListItem}" MouseDoubleClick="OpenWorldUpdate_Click">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Border Style="{StaticResource Chip}" VerticalAlignment="Top" Margin="0,2,14,0">
                        <TextBlock Text="{Binding Kind}" Style="{StaticResource ChipText}"
                                   Foreground="{StaticResource Accent}"/>
                      </Border>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" FontSize="17"/>
                        <TextBlock Text="{Binding Body}" Style="{StaticResource BodyMuted}" Margin="0,5,0,0"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Margin="14,0,0,0" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd MMM HH:mm}}"
                                   Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                        <Border Background="{StaticResource InteractiveWash}" CornerRadius="9" Padding="8,2"
                                Margin="0,6,0,0" HorizontalAlignment="Right">
                          <TextBlock Text="NEW" Foreground="{StaticResource Interactive}" FontSize="10" FontWeight="Bold"/>
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Visibility" Value="Visible"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRead}" Value="True">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding Notifications.Count, Converter={StaticResource Empty}, ConverterParameter=Invert}">
              <Button Content="OPEN SELECTED UPDATE" Click="OpenWorldUpdate_Click"/>
              <TextBlock Text="or double-click any update" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- ============================== PRE-MATCH ============================== -->
        <ScrollViewer x:Name="PreMatchPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Pre-match briefing" Style="{StaticResource Heading}"/>
            <TextBlock Text="Grounded in the opponent squad, manager, rivalry, and venue the latest save exposes."
                       Style="{StaticResource Subheading}"/>

            <Border Style="{StaticResource HeroCard}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="NEXT OPPONENT" Style="{StaticResource Label}"/>
                  <TextBlock Text="{Binding PreMatchOpponent}" Style="{StaticResource Metric}"/>
                  <TextBlock Text="{Binding PreMatchMeta}" Style="{StaticResource BodyMuted}" Margin="0,7,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource AccentWash}" BorderBrush="{StaticResource Accent}"
                        BorderThickness="1" CornerRadius="6" Padding="14,8" VerticalAlignment="Center">
                  <TextBlock Text="MATCHDAY" Foreground="{StaticResource Accent}" FontSize="15" FontWeight="Bold"/>
                </Border>
              </Grid>
            </Border>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="RECENT FORM" Style="{StaticResource Label}"/>
                  <ItemsControl ItemsSource="{Binding PreMatchForm, Converter={StaticResource FormPills}}"
                                ItemTemplate="{StaticResource FormPillTemplate}"
                                ItemsPanel="{StaticResource RowPanel}" Margin="0,4,0,0"/>
                  <TextBlock Text="Not enough matches to show a form guide." Style="{StaticResource Caption}"
                             Margin="0,2,0,0"
                             Visibility="{Binding HasForm, Converter={StaticResource Bool}, ConverterParameter=Invert}"/>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="YOUR AVAILABILITY" Style="{StaticResource Label}"/>
                  <TextBlock Text="{Binding PreMatchAvailability}" Style="{StaticResource CardTitle}" FontSize="16"
                             Foreground="{Binding PreMatchAvailability, Converter={StaticResource AvailabilityBrush}}"/>
                </StackPanel>
              </Border>

              <Border Grid.Column="4" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="YOUR KEY PLAYERS" Style="{StaticResource Label}"/>
                  <TextBlock Text="{Binding PreMatchKeyPlayers}" Style="{StaticResource Body}"/>
                </StackPanel>
              </Border>
            </Grid>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Border Style="{StaticResource CardRaised}">
                <StackPanel>
                  <TextBlock Text="FIFA MATCH BRIEFING" Style="{StaticResource Label}"/>
                  <TextBlock Text="{Binding PreMatchIntel}" Style="{StaticResource Prose}"/>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="OPPOSITION SCOUTING" Style="{StaticResource Label}"/>
                  <TextBlock Text="{Binding PreMatchScouting}" Style="{StaticResource Prose}"/>
                </StackPanel>
              </Border>
            </Grid>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="PREPARE" Style="{StaticResource Label}"/>
                <TextBlock Text="Set the tone before kickoff. Each conversation opens with the fixture context already prepared."
                           Style="{StaticResource BodyMuted}" Margin="0,0,0,12"/>
                <WrapPanel>
                  <Button Content="TALK TO A TEAMMATE" Click="TalkTeammate_Click"/>
                  <Button Content="TALK TO THE MANAGER" Click="TalkManager_Click" Style="{StaticResource SecondaryButton}"/>
                  <Button Content="OPEN THE PRESS ROOM" Click="OpenPress_Click" Style="{StaticResource GhostButton}"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ============================== REVIEW INBOX ============================== -->
        <ScrollViewer x:Name="ReviewInboxPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Match review inbox" Style="{StaticResource Heading}"/>
            <TextBlock Text="Matches import on their own. Only results FIFA left genuinely ambiguous arrive here, already filled in."
                       Style="{StaticResource Subheading}"/>

            <Border Style="{StaticResource EmptyState}"
                    Visibility="{Binding PendingMatchReviews.Count, Converter={StaticResource Empty}}">
              <StackPanel>
                <TextBlock Text="Nothing needs your attention" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="Every detected match has been imported with enough evidence to stand on its own."
                           Style="{StaticResource BodyMuted}" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>

            <Grid Visibility="{Binding PendingMatchReviews.Count, Converter={StaticResource Empty}, ConverterParameter=Invert}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*"/>
              </Grid.ColumnDefinitions>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="{Binding MatchReviewCount}" Style="{StaticResource Label}"
                             Foreground="{StaticResource Warm}"/>
                  <ListBox ItemsSource="{Binding PendingMatchReviews}" SelectedItem="{Binding SelectedMatchReview}"
                           MinHeight="320" MouseDoubleClick="OpenSelectedReview_Click">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Score}" Foreground="{StaticResource Accent}" FontSize="18"
                                     FontWeight="Bold" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Opponent}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Date}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                          </StackPanel>
                          <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Confidence}" Foreground="{StaticResource Interactive}"
                                       FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding Venue}" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Right" Margin="0,2,0,0"/>
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource CardRaised}">
                <StackPanel>
                  <TextBlock Text="DETECTION EVIDENCE" Style="{StaticResource Label}"/>
                  <TextBlock Text="{Binding SelectedMatchReview.Opponent}" Style="{StaticResource MetricSmall}"/>
                  <TextBlock Text="{Binding SelectedReviewDetails}" Style="{StaticResource BodyMuted}" Margin="0,10,0,14"/>
                  <TextBlock Text="{Binding SelectedMatchReview.Captured}" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding SelectedMatchReview.Source}" Style="{StaticResource Mono}" Margin="0,3,0,0"/>
                  <Button Content="REVIEW AND IMPORT" Click="OpenSelectedReview_Click" Margin="0,18,0,8"
                          HorizontalAlignment="Stretch"/>
                  <Button Content="DISMISS DETECTION" Click="DismissSelectedReview_Click"
                          Style="{StaticResource DangerButton}" HorizontalAlignment="Stretch" Margin="0"/>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <!-- ============================== SQUAD ============================== -->
        <ScrollViewer x:Name="SquadPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Squad" Style="{StaticResource Heading}"/>
            <TextBlock Text="Reconciled from the save by stable FIFA player id. Departures keep their history."
                       Style="{StaticResource Subheading}"/>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*"/>
              </Grid.ColumnDefinitions>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SquadSearchBox" app:Hint.Text="Search name, position, nationality, number"
                             Text="{Binding SquadSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1" Width="150" Margin="0" ItemsSource="{Binding SquadFilters}"
                              SelectedItem="{Binding SelectedSquadFilter}"/>
                  </Grid>
                  <TextBlock Text="{Binding SquadCountLabel}" Style="{StaticResource Label}"/>

                  <ListBox ItemsSource="{Binding SquadMembers}" SelectedItem="{Binding SelectedSquadMember}"
                           MinHeight="360">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="72"/><ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <Border Background="{StaticResource Sidebar}" CornerRadius="5" Width="34" Height="30"
                                  HorizontalAlignment="Left">
                            <TextBlock Text="{Binding ShirtLabel}" Foreground="{StaticResource Accent}"
                                       FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                          </Border>
                          <StackPanel Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                              <Run Text="{Binding Position, Mode=OneWay}"/>
                              <Run Text="  ·  " Foreground="{StaticResource Stroke}"/>
                              <Run Text="{Binding Nationality, Mode=OneWay}"/>
                            </TextBlock>
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding OverallLabel}" FontWeight="Bold" FontSize="13"
                                     VerticalAlignment="Center"
                                     Foreground="{Binding Overall, Converter={StaticResource OverallBrush}}"/>
                          <TextBlock Grid.Column="3" Text="{Binding Availability}" FontSize="11" FontWeight="SemiBold"
                                     VerticalAlignment="Center" HorizontalAlignment="Right"
                                     Foreground="{Binding Availability, Converter={StaticResource AvailabilityBrush}}"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                  <TextBlock Text="No player matches this filter." Style="{StaticResource BodyMuted}"
                             Margin="4,10,0,0"
                             Visibility="{Binding SquadMembers.Count, Converter={StaticResource Empty}}"/>
                </StackPanel>
              </Border>

              <StackPanel Grid.Column="2">
                <Border Style="{StaticResource CardRaised}">
                  <StackPanel>
                    <TextBlock Text="PLAYER DETAIL" Style="{StaticResource Label}"/>
                    <TextBlock Text="{Binding SelectedSquadMember.Name, FallbackValue=Select a player}"
                               Style="{StaticResource MetricSmall}"/>
                    <TextBlock Text="{Binding SelectedSquadFacts}" Style="{StaticResource BodyMuted}" Margin="0,10,0,10"/>
                    <StackPanel Visibility="{Binding SelectedSquadMember, Converter={StaticResource Empty}, ConverterParameter=Invert}">
                      <Border Background="{StaticResource AccentWash}" CornerRadius="6" Padding="12,9">
                        <TextBlock Text="{Binding SelectedSquadRelationship}" Foreground="{StaticResource Accent}"
                                   FontSize="13" TextWrapping="Wrap"/>
                      </Border>
                      <WrapPanel Margin="0,14,0,0">
                        <Button Content="MESSAGE" Click="MessageSelectedPlayer_Click"/>
                        <Button Content="EDIT PROFILE" Click="EditProfile_Click" Style="{StaticResource SecondaryButton}" Margin="0"/>
                      </WrapPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="OTHER CHARACTERS" Style="{StaticResource Label}"/>
                    <ListBox ItemsSource="{Binding OtherCharacters}" SelectedItem="{Binding SelectedCharacter}"
                             MaxHeight="180">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding Type, Converter={StaticResource Humanize}}" Style="{StaticResource Caption}"/>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}"
                        Visibility="{Binding FormerTeammates.Count, Converter={StaticResource Empty}, ConverterParameter=Invert}">
                  <StackPanel>
                    <TextBlock Text="FORMER TEAMMATES" Style="{StaticResource Label}"/>
                    <ItemsControl ItemsSource="{Binding FormerTeammates}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource Muted}">
                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text="  ·  "/>
                            <Run Text="{Binding Position, Mode=OneWay}"/>
                            <Run Text="  ·  "/>
                            <Run Text="{Binding OverallLabel, Mode=OneWay}"/>
                          </TextBlock>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="ADD A CHARACTER BY HAND" Style="{StaticResource Label}"/>
                <TextBlock Text="For anyone the save does not expose: a friend at another club, a family member, a rival."
                           Style="{StaticResource BodyMuted}" Margin="0,0,0,14"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding CharacterName}" app:Hint.Text="Full name"/>
                    <TextBlock Text="Age" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding CharacterAge}" app:Numeric.Mode="Integer"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Nationality" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding CharacterNationality}"/>
                    <TextBlock Text="Position" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding CharacterPosition}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="4">
                    <TextBlock Text="Squad role" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding CharacterRole}"/>
                    <TextBlock Text="Type" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding CharacterTypes}" SelectedItem="{Binding CharacterType}"/>
                  </StackPanel>
                </Grid>
                <Button Content="ADD CHARACTER" Click="AddCharacter_Click" HorizontalAlignment="Left" Margin="0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ============================== MESSAGES ============================== -->
        <Grid x:Name="MessagesPage" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Messages" Style="{StaticResource Heading}"/>
            <TextBlock Text="{Binding MessageInboxSummary}" Style="{StaticResource Subheading}"/>
          </StackPanel>

          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="270"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0" Padding="10">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="CONVERSATIONS" Style="{StaticResource Label}" Margin="8,6,0,6"/>
                <ListBox ItemsSource="{Binding MessageCharacters}" SelectedItem="{Binding SelectedCharacter}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource Panel2}"
                                Margin="0,0,10,0">
                          <TextBlock Text="{Binding Name, Converter={StaticResource Initials}}" FontSize="11"
                                     FontWeight="Bold" Foreground="{StaticResource Accent}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                     TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Type, Converter={StaticResource Humanize}}" Style="{StaticResource Caption}"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="{StaticResource Panel2}" CornerRadius="8,8,0,0" Padding="18,12"
                        BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1">
                  <StackPanel>
                    <TextBlock Text="{Binding SelectedCharacter.Name, FallbackValue=Select a conversation}"
                               Style="{StaticResource CardTitle}" FontSize="17"/>
                    <TextBlock Text="{Binding SelectedRelationship}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  </StackPanel>
                </Border>

                <ScrollViewer x:Name="MessageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,14">
                  <StackPanel>
                    <Border Style="{StaticResource EmptyState}" Margin="0,10,0,0"
                            Visibility="{Binding Messages.Count, Converter={StaticResource Empty}}">
                      <StackPanel>
                        <TextBlock Text="No messages yet" Style="{StaticResource CardTitle}" FontSize="16"/>
                        <TextBlock Text="Write below to open the conversation. Automatic first messages arrive on their own after matches."
                                   Style="{StaticResource BodyMuted}" Margin="0,6,0,0"/>
                      </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Messages}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" MaxWidth="720" HorizontalAlignment="Left"
                                    CornerRadius="12,12,12,3" Padding="15,11">
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="Background" Value="{StaticResource Panel2}"/>
                                  <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
                                  <Setter Property="BorderThickness" Value="1"/>
                                  <Setter Property="TextElement.Foreground" Value="{StaticResource Text}"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Role}" Value="user">
                                      <Setter Property="Grid.Column" Value="2"/>
                                      <Setter Property="HorizontalAlignment" Value="Right"/>
                                      <Setter Property="CornerRadius" Value="12,12,3,12"/>
                                      <Setter Property="Background" Value="{StaticResource Interactive}"/>
                                      <Setter Property="BorderBrush" Value="{StaticResource Interactive}"/>
                                      <Setter Property="TextElement.Foreground" Value="#141034"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                  <TextBlock Text="{Binding DisplayRole}" Style="{StaticResource BubbleMeta}"
                                             FontWeight="Bold"/>
                                  <TextBlock DockPanel.Dock="Right" Text="{Binding DisplayTimestamp}"
                                             Style="{StaticResource BubbleMeta}" Margin="16,0,0,0"/>
                                </DockPanel>
                                <TextBlock Text="{Binding ConversationContext}" Style="{StaticResource BubbleMeta}"
                                           Visibility="{Binding ConversationContext, Converter={StaticResource Empty}, ConverterParameter=Invert}"/>
                                <TextBlock Text="{Binding ReplyContext}" Style="{StaticResource BubbleMeta}"
                                           FontSize="11" FontStyle="Italic" Margin="0,6,0,0"
                                           Visibility="{Binding ReplyContext, Converter={StaticResource Empty}, ConverterParameter=Invert}"/>
                                <TextBlock Text="{Binding DisplayContent}" Style="{StaticResource BubbleText}"
                                           Margin="0,6,0,0" FontSize="14" LineHeight="21"/>
                              </StackPanel>
                            </Border>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="{StaticResource Panel2}" CornerRadius="0,0,8,8" Padding="18,14"
                        BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0">
                  <StackPanel>
                    <TextBox x:Name="ComposerBox" Style="{StaticResource Editor}" MinHeight="72"
                             Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                             app:Hint.Text="Write a message. Enter sends, Shift+Enter starts a new line."
                             PreviewKeyDown="Composer_PreviewKeyDown"/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <ComboBox Width="210" Margin="0" ItemsSource="{Binding SceneTypes}"
                                SelectedItem="{Binding SelectedScene}" ToolTip="Where this conversation is happening">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource Humanize}}"/>
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBlock Grid.Column="1" Text="{Binding MessageGenerationStatus}" Style="{StaticResource Caption}"
                                 VerticalAlignment="Center" Margin="14,0" TextTrimming="CharacterEllipsis"/>
                      <Button Grid.Column="2" Content="SEND" Click="SendMessage_Click" Width="110" Margin="0"/>
                    </Grid>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <!-- ============================== MANAGER ============================== -->
        <ScrollViewer x:Name="ManagerPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Manager's office" Style="{StaticResource Heading}"/>
            <TextBlock Text="The verified club manager and your representative, synchronized from the save."
                       Style="{StaticResource Subheading}"/>

            <Border Style="{StaticResource HeroCard}">
              <StackPanel>
                <TextBlock Text="CURRENT MANAGER" Style="{StaticResource Label}"/>
                <TextBlock Text="{Binding ManagerName}" Style="{StaticResource Metric}"/>
                <TextBlock Text="{Binding ManagerRelationship}" Foreground="{StaticResource Accent}" Margin="0,7,0,0"/>
              </StackPanel>
            </Border>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*"/>
              </Grid.ColumnDefinitions>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="OFFICE BRIEFING" Style="{StaticResource Label}"/>
                  <TextBlock Text="{Binding ManagerBriefing}" Style="{StaticResource Prose}" Margin="0,0,0,14"/>
                  <Button Content="REQUEST A MEETING" Click="TalkManager_Click" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                  <TextBlock Text="Touchline adds the verified FIFA club manager automatically and sends grounded reactions after important matches."
                             Style="{StaticResource Caption}"/>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource CardRaised}">
                <StackPanel>
                  <TextBlock Text="REPRESENTATIVE" Style="{StaticResource Label}"/>
                  <TextBlock Text="{Binding AgentName}" Style="{StaticResource MetricSmall}"/>
                  <TextBlock Text="Your FIFA agent is synchronized whenever the save exposes a name."
                             Style="{StaticResource Caption}" Margin="0,6,0,14"/>
                  <Button Content="CONTACT AGENT" Click="TalkAgent_Click" Style="{StaticResource SecondaryButton}"
                          HorizontalAlignment="Stretch" Margin="0"/>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <!-- ============================== PRESS ============================== -->
        <ScrollViewer x:Name="PressPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Press room" Style="{StaticResource Heading}"/>
            <TextBlock Text="Interviews are reserved for exceptional performances, major fixtures, controversy, streaks, and significant defeats."
                       Style="{StaticResource Subheading}"/>

            <Border Style="{StaticResource Card}" Visibility="{Binding InterviewVisibility}">
              <StackPanel>
                <TextBlock Text="{Binding InterviewProgress}" Style="{StaticResource Label}"
                           Foreground="{StaticResource Interactive}"/>

                <ItemsControl ItemsSource="{Binding InterviewTranscript}" Margin="0,6,0,16">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource Panel2}" CornerRadius="6" Padding="13,9" Margin="0,0,0,5">
                        <TextBlock Text="{Binding}" Style="{StaticResource Body}"/>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="{StaticResource AccentWash}" BorderBrush="{StaticResource Accent}"
                        BorderThickness="0,0,0,0" CornerRadius="8" Padding="18,15" Margin="0,0,0,18">
                  <TextBlock Text="{Binding PressQuestion}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"
                             LineHeight="27"/>
                </Border>

                <TextBlock Text="Your answer" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource Editor}" MinHeight="120"
                         Text="{Binding PressAnswer, UpdateSourceTrigger=PropertyChanged}"
                         app:Hint.Text="Speak for yourself. What you say here reaches the manager, the dressing room, and the press."/>
                <WrapPanel>
                  <Button Content="SUBMIT ANSWER" Click="RecordPress_Click"/>
                  <Button Content="DECLINE INTERVIEW" Click="DeclineInterview_Click" Style="{StaticResource GhostButton}"/>
                </WrapPanel>
                <TextBlock Text="{Binding InterviewGenerationStatus}" Foreground="{StaticResource Interactive}"
                           FontSize="12" Margin="0,8,0,0"/>
                <TextBlock Text="The journalist reacts to your answer and asks a grounded follow-up. Without a model key, an offline response is used."
                           Style="{StaticResource Caption}" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding InterviewCompleteVisibility}">
              <StackPanel>
                <TextBlock Text="{Binding InterviewCompletionText}" Foreground="{StaticResource Interactive}"
                           Style="{StaticResource MetricSmall}"/>
                <ItemsControl ItemsSource="{Binding InterviewTranscript}" Margin="0,12,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource Panel2}" CornerRadius="6" Padding="13,9" Margin="0,0,0,5">
                        <TextBlock Text="{Binding}" Style="{StaticResource Body}"/>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource EmptyState}" Visibility="{Binding NoInterviewVisibility}">
              <StackPanel>
                <TextBlock Text="No media duty" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="{Binding PressQuestion}" Style="{StaticResource BodyMuted}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ============================== NEWS ============================== -->
        <ScrollViewer x:Name="NewsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="News" Style="{StaticResource Heading}"/>
            <TextBlock Text="Differentiated outlets covering what your career actually did."
                       Style="{StaticResource Subheading}"/>

            <Border Style="{StaticResource EmptyState}" Visibility="{Binding News.Count, Converter={StaticResource Empty}}">
              <TextBlock Text="No coverage yet. Minor results are ignored on purpose - the press only writes when something mattered."
                         Style="{StaticResource BodyMuted}"/>
            </Border>

            <ItemsControl ItemsSource="{Binding News}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,6">
                        <Border Style="{StaticResource Chip}" Background="{StaticResource AccentWash}"
                                BorderBrush="{StaticResource Accent}">
                          <TextBlock Text="{Binding Outlet}" Style="{StaticResource ChipText}"
                                     Foreground="{StaticResource Accent}"/>
                        </Border>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PublishedAt, StringFormat={}{0:dd MMM yyyy}}"
                                   Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                      </DockPanel>
                      <TextBlock Text="{Binding Headline}" Style="{StaticResource CardTitle}"/>
                      <TextBlock Text="{Binding Body}" Style="{StaticResource BodyMuted}" Margin="0,7,0,0"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- ============================== SOCIAL ============================== -->
        <ScrollViewer x:Name="SocialPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Social" Style="{StaticResource Heading}"/>
            <TextBlock Text="Personas with their own voice, reacting only when there is something to react to."
                       Style="{StaticResource Subheading}"/>

            <Border Style="{StaticResource EmptyState}" Visibility="{Binding Social.Count, Converter={StaticResource Empty}}">
              <TextBlock Text="The timeline is quiet." Style="{StaticResource BodyMuted}"/>
            </Border>

            <ItemsControl ItemsSource="{Binding Social}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource Panel2}"
                              VerticalAlignment="Top" Margin="0,0,14,0">
                        <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                   Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1">
                        <DockPanel>
                          <TextBlock Text="{Binding Author}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding PublishedAt, StringFormat={}{0:dd MMM yyyy}}"
                                     Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Persona}" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
                        <TextBlock Text="{Binding Content}" Style="{StaticResource Body}" Margin="0,8,0,0"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- ============================== TIMELINE ============================== -->
        <ScrollViewer x:Name="TimelinePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Career timeline" Style="{StaticResource Heading}"/>
            <TextBlock Text="Every recorded event, newest first, coloured by how much it mattered."
                       Style="{StaticResource Subheading}"/>

            <Border Style="{StaticResource EmptyState}" Visibility="{Binding Events.Count, Converter={StaticResource Empty}}">
              <TextBlock Text="No events recorded yet." Style="{StaticResource BodyMuted}"/>
            </Border>

            <ItemsControl ItemsSource="{Binding Events}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Rail: a continuous line with a node per event -->
                    <Grid Width="26">
                      <Border Width="2" Background="{StaticResource Stroke}" HorizontalAlignment="Center"/>
                      <Ellipse Width="10" Height="10" VerticalAlignment="Top" Margin="0,22,0,0"
                               Fill="{Binding Importance, Converter={StaticResource ImportanceBrush}}"/>
                    </Grid>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,12">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="118"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Timestamp, StringFormat={}{0:dd MMM yyyy}}"
                                   Style="{StaticResource Caption}" Foreground="{StaticResource Muted}"/>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Type, Converter={StaticResource Humanize}}"
                                     FontWeight="SemiBold" FontSize="13"/>
                          <TextBlock Text="{Binding Summary}" Style="{StaticResource BodyMuted}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource Chip}" Margin="14,0,0,0" VerticalAlignment="Top">
                          <TextBlock Text="{Binding Importance}" Style="{StaticResource ChipText}"
                                     Foreground="{Binding Importance, Converter={StaticResource ImportanceBrush}}"/>
                        </Border>
                      </Grid>
                    </Border>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- ============================== MATCH CENTRE ============================== -->
        <ScrollViewer x:Name="MatchPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Match centre" Style="{StaticResource Heading}"/>
            <TextBlock Text="FIFA imports matches on its own. Use this to correct a detail, or to log a match by hand."
                       Style="{StaticResource Subheading}"/>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="LOG OR CORRECT A MATCH" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Content="NEW BLANK MATCH" Click="NewManualMatch_Click"
                          Style="{StaticResource GhostButton}" Margin="0"/>
                </Grid>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <!-- Fixture -->
                  <StackPanel>
                    <TextBlock Text="FIXTURE" Style="{StaticResource Label}"/>
                    <TextBlock Text="Date" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding MatchDate}" app:Hint.Text="yyyy-mm-dd"/>
                    <TextBlock Text="Competition" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding MatchCompetition}"/>
                    <TextBlock Text="Opponent" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding MatchOpponent}" app:Hint.Text="Required"/>
                    <TextBlock Text="Next opponent" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding MatchNextOpponent}"/>
                    <CheckBox Content="Home match" IsChecked="{Binding MatchHome}" Style="{StaticResource ToggleSwitch}"/>
                    <CheckBox Content="International match" IsChecked="{Binding InternationalMatch}"
                              Style="{StaticResource ToggleSwitch}"/>
                    <TextBlock Text="Representing team" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding RepresentingTeam}"/>
                  </StackPanel>

                  <!-- Your match -->
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="YOUR MATCH" Style="{StaticResource Label}"/>
                    <TextBlock Text="Score (us / them)" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBox Text="{Binding TeamScore}" app:Numeric.Mode="Integer"/>
                      <TextBox Grid.Column="2" Text="{Binding OpponentScore}" app:Numeric.Mode="Integer"/>
                    </Grid>
                    <Border Background="{StaticResource DangerWash}" CornerRadius="5" Padding="10,7" Margin="0,0,0,12"
                            Visibility="{Binding ScoreReviewVisibility}">
                      <TextBlock Text="FIFA has not published the final score for this match. Leave it if you would rather wait; Touchline fills it in once a later save publishes it."
                                 Foreground="{StaticResource Warm}" FontSize="11" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Goals / assists" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBox Text="{Binding Goals}" app:Numeric.Mode="Integer"/>
                      <TextBox Grid.Column="2" Text="{Binding Assists}" app:Numeric.Mode="Integer"/>
                    </Grid>

                    <TextBlock Text="Rating / minutes" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBox Text="{Binding Rating}" app:Numeric.Mode="Decimal"/>
                      <TextBox Grid.Column="2" Text="{Binding Minutes}" app:Numeric.Mode="Integer"/>
                    </Grid>

                    <CheckBox Content="Started the match" IsChecked="{Binding Started}" Style="{StaticResource ToggleSwitch}"/>
                    <Border Background="{StaticResource DangerWash}" CornerRadius="5" Padding="10,7"
                            Visibility="{Binding StartedReviewVisibility}">
                      <TextBlock Text="Starter status was not recorded for this match. Change this only if you know it."
                                 Foreground="{StaticResource Warm}" FontSize="11" TextWrapping="Wrap"/>
                    </Border>
                  </StackPanel>

                  <!-- What happened -->
                  <StackPanel Grid.Column="4">
                    <TextBlock Text="WHAT HAPPENED" Style="{StaticResource Label}"/>
                    <CheckBox Content="Yellow card" IsChecked="{Binding YellowCard}"/>
                    <CheckBox Content="Red card" IsChecked="{Binding RedCard}"/>
                    <CheckBox Content="Penalty scored" IsChecked="{Binding PenaltyScored}"/>
                    <CheckBox Content="Penalty missed" IsChecked="{Binding PenaltyMissed}"/>
                    <CheckBox Content="Derby or rivalry" IsChecked="{Binding IsDerby}"/>
                    <CheckBox Content="Major fixture" IsChecked="{Binding IsMajor}"/>
                    <TextBlock Text="Notable objective detail" Style="{StaticResource FieldLabel}" Margin="2,8,0,4"/>
                    <TextBox Style="{StaticResource Editor}" MinHeight="76" Text="{Binding MatchNotes}"
                             app:Hint.Text="e.g. 90+2 late winner"/>
                  </StackPanel>
                </Grid>

                <WrapPanel Margin="0,6,0,0">
                  <Button Content="{Binding MatchSubmitLabel}" Click="ProcessMatch_Click" MinWidth="180"/>
                  <Button Content="CANCEL EDIT" Click="CancelMatchEdit_Click" Style="{StaticResource GhostButton}"
                          Visibility="{Binding MatchEditVisibility}"/>
                </WrapPanel>
                <TextBlock Text="{Binding MatchResultSummary}" Foreground="{StaticResource Accent}"
                           Style="{StaticResource Body}" Margin="0,10,0,0"
                           Visibility="{Binding MatchResultSummary, Converter={StaticResource Empty}, ConverterParameter=Invert}"/>
              </StackPanel>
            </Border>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*"/>
              </Grid.ColumnDefinitions>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="MATCH HISTORY" Style="{StaticResource Label}"/>
                  <ListBox ItemsSource="{Binding MatchHistory}" SelectedItem="{Binding SelectedLoggedMatch}"
                           MinHeight="260" MouseDoubleClick="EditMatch_Click">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <Border Width="22" Height="22" CornerRadius="11" Margin="0,0,12,0"
                                  Background="{StaticResource Panel2}">
                            <TextBlock Text="{Binding Result}" FontSize="11" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource Muted}"/>
                          </Border>
                          <TextBlock Grid.Column="1" Text="{Binding Input.Date}" Style="{StaticResource Caption}"
                                     VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding Input.Opponent}" FontWeight="SemiBold" FontSize="13"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Input.TeamContext}" Style="{StaticResource Caption}"/>
                          </StackPanel>
                          <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center"
                                     FontWeight="Bold" FontSize="14">
                            <Run Text="{Binding Input.TeamScore, Mode=OneWay}"/><Run Text="-"/><Run Text="{Binding Input.OpponentScore, Mode=OneWay}"/>
                          </TextBlock>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Text="No matches logged yet." Style="{StaticResource BodyMuted}" Margin="4,10,0,0"
                             Visibility="{Binding MatchHistory.Count, Converter={StaticResource Empty}}"/>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource CardRaised}">
                <StackPanel>
                  <TextBlock Text="SELECTED MATCH" Style="{StaticResource Label}"/>
                  <TextBlock Text="{Binding SelectedMatchHistoryDetails}" Style="{StaticResource Body}" Margin="0,0,0,16"/>
                  <Button Content="EDIT THIS MATCH" Click="EditMatch_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                  <Button Content="DELETE MANUAL MATCH" Click="DeleteMatch_Click" Style="{StaticResource DangerButton}"
                          HorizontalAlignment="Stretch" Margin="0"/>
                  <TextBlock Text="FIFA synchronized matches can be corrected but not deleted, because they anchor automatic stat detection."
                             Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <!-- ============================== CAREER SETUP ============================== -->
        <ScrollViewer x:Name="CareerPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="Career setup" Style="{StaticResource Heading}"/>
            <TextBlock Text="Touchline reads FIFA saves. It never writes to them." Style="{StaticResource Subheading}"/>

            <Border Style="{StaticResource CardRaised}">
              <StackPanel>
                <TextBlock Text="AUTOMATIC FIFA 18 SYNC" Style="{StaticResource Label}"
                           Foreground="{StaticResource Interactive}"/>
                <TextBlock Text="Reads the newest Career save without modifying FIFA or its files."
                           Style="{StaticResource BodyMuted}" Margin="0,0,0,14"/>

                <TextBlock Text="Detected settings directory" Style="{StaticResource FieldLabel}"/>
                <Border Background="{StaticResource Sidebar}" CornerRadius="5" Padding="11,8" Margin="0,0,0,14">
                  <TextBlock Text="{Binding FifaSettingsDirectory}" Style="{StaticResource Mono}"/>
                </Border>

                <CheckBox Content="Watch for completed FIFA saves automatically" Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding AutoFifaWatch}" Click="AutoFifaWatch_Click"/>
                <CheckBox Content="Synchronize FIFA teammates automatically" Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding AutoFifaSquadSync}" Click="FifaPreference_Click"/>

                <Button Content="SCAN NEWEST FIFA SAVE" Click="ScanFifa_Click" HorizontalAlignment="Left"
                        Margin="0,6,0,10"/>
                <TextBlock Text="{Binding FifaSyncStatus}" Style="{StaticResource BodyMuted}"/>

                <TextBlock Text="DETECTED FIXTURE HISTORY" Style="{StaticResource Label}" Margin="0,18,0,6"/>
                <ItemsControl ItemsSource="{Binding Fixtures}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource Panel}" CornerRadius="5" Padding="12,8" Margin="0,0,0,5">
                        <StackPanel>
                          <TextBlock FontSize="13">
                            <Run Text="{Binding Date, Mode=OneWay}" Foreground="{StaticResource Muted}"/>
                            <Run Text="   "/>
                            <Run Text="{Binding Opponent, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text="   "/>
                            <Run Text="{Binding Competition, Mode=OneWay}" Foreground="{StaticResource Muted}"/>
                          </TextBlock>
                          <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No fixtures detected yet." Style="{StaticResource Caption}"
                           Visibility="{Binding Fixtures.Count, Converter={StaticResource Empty}}"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="YOUR CAREERS" Style="{StaticResource Label}"/>
                <ListBox ItemsSource="{Binding Careers}" SelectedItem="{Binding CurrentCareer}" MaxHeight="200">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding SaveName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                            <Run Text="{Binding PlayerName, Mode=OneWay}"/>
                            <Run Text="  ·  "/>
                            <Run Text="{Binding Club, Mode=OneWay}"/>
                          </TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Season}" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="Selecting a career opens it straight away." Style="{StaticResource Caption}"
                           Margin="4,8,0,0"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="CREATE A CAREER BY HAND" Style="{StaticResource Label}"/>
                <TextBlock Text="Use this when you want a world without a linked save." Style="{StaticResource BodyMuted}"
                           Margin="0,0,0,14"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Save name" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding NewSaveName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Player name" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding NewPlayerName}" app:Hint.Text="Required"/>
                    <TextBlock Text="Nationality" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding NewNationality}"/>
                    <TextBlock Text="Age" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding NewAge}" app:Numeric.Mode="Integer"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Club" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding NewClub}" app:Hint.Text="Required"/>
                    <TextBlock Text="League and season" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="120"/>
                      </Grid.ColumnDefinitions>
                      <TextBox Text="{Binding NewLeague}"/>
                      <TextBox Grid.Column="2" Text="{Binding NewSeason}"/>
                    </Grid>
                    <TextBlock Text="Position and shirt number" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="120"/>
                      </Grid.ColumnDefinitions>
                      <TextBox Text="{Binding NewPosition}"/>
                      <TextBox Grid.Column="2" Text="{Binding NewShirtNumber}" app:Numeric.Mode="Integer"/>
                    </Grid>
                  </StackPanel>
                </Grid>
                <Button Content="CREATE CAREER" Click="CreateCareer_Click" HorizontalAlignment="Left" Margin="0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ============================== SETTINGS ============================== -->
        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource Heading}"/>
            <TextBlock Text="Touchline runs completely offline. A model only ever adds language on top of facts it is given."
                       Style="{StaticResource Subheading}"/>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="AI PROVIDER" Style="{StaticResource Label}"/>
                <TextBlock Text="API key" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="ApiKeyBox"/>
                <TextBlock Text="Encrypted for this Windows user with DPAPI. Leave blank for Ollama or a local endpoint."
                           Style="{StaticResource Caption}" Margin="2,-6,0,14"/>

                <TextBlock Text="Default and premium model" Style="{StaticResource FieldLabel}"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding DefaultModel, Mode=TwoWay}"/>
                  <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableModels}"
                            SelectedItem="{Binding PremiumModel, Mode=TwoWay}"/>
                </Grid>

                <TextBlock Text="OpenAI-compatible endpoint" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding CompatibleEndpoint, UpdateSourceTrigger=PropertyChanged}"
                         app:Hint.Text="https://openrouter.ai/api/v1"
                         ToolTip="Examples: https://openrouter.ai/api/v1 or http://localhost:1234/v1"/>
                <TextBlock Text="OpenRouter models switch to the OpenRouter endpoint automatically. Premium routing falls back to your default model when the premium choice has no matching key."
                           Style="{StaticResource Caption}" Margin="2,-6,0,14"/>

                <CheckBox Content="Use the premium model for major events" IsChecked="{Binding PremiumRouting}"
                          Style="{StaticResource ToggleSwitch}"/>
                <Button Content="SAVE PROVIDER SETTINGS" Click="SaveSettings_Click" HorizontalAlignment="Left" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="GENERATION" Style="{StaticResource Label}"/>
                <TextBlock Text="What the world is allowed to produce on its own after a match."
                           Style="{StaticResource BodyMuted}" Margin="0,0,0,14"/>
                <CheckBox Content="Automatic teammate reactions" IsChecked="{Binding AutoTeammates}" Style="{StaticResource ToggleSwitch}"/>
                <CheckBox Content="Automatic manager reactions" IsChecked="{Binding AutoManager}" Style="{StaticResource ToggleSwitch}"/>
                <CheckBox Content="Automatic news" IsChecked="{Binding AutoNews}" Style="{StaticResource ToggleSwitch}"/>
                <CheckBox Content="Automatic social posts" IsChecked="{Binding AutoSocial}" Style="{StaticResource ToggleSwitch}"/>
                <CheckBox Content="Automatic press prompts" IsChecked="{Binding AutoPress}" Style="{StaticResource ToggleSwitch}"/>
                <CheckBox Content="Developer and debug mode" IsChecked="{Binding DebugMode}" Style="{StaticResource ToggleSwitch}"/>
                <Button Content="SAVE PREFERENCES" Click="SaveSettings_Click" HorizontalAlignment="Left" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="BACKUP" Style="{StaticResource Label}"/>
                <TextBlock Text="A consistent, portable SQLite copy of every career. Restoring replaces all local data."
                           Style="{StaticResource BodyMuted}" Margin="0,0,0,14"/>
                <WrapPanel>
                  <Button Content="EXPORT BACKUP" Click="Backup_Click"/>
                  <Button Content="RESTORE BACKUP" Click="Restore_Click" Style="{StaticResource DangerButton}" Margin="0"/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="KEYBOARD" Style="{StaticResource Label}"/>
                <TextBlock Style="{StaticResource BodyMuted}">
                  <Run Text="Ctrl+K" FontWeight="Bold" Foreground="{StaticResource Interactive}"/><Run Text="  go to anything"/>
                  <LineBreak/>
                  <Run Text="Ctrl+1 - 9" FontWeight="Bold" Foreground="{StaticResource Interactive}"/><Run Text="  jump to a section"/>
                  <LineBreak/>
                  <Run Text="F5" FontWeight="Bold" Foreground="{StaticResource Interactive}"/><Run Text="  scan the newest FIFA save"/>
                  <LineBreak/>
                  <Run Text="Enter" FontWeight="Bold" Foreground="{StaticResource Interactive}"/><Run Text="  send a message, Shift+Enter for a new line"/>
                  <LineBreak/>
                  <Run Text="Esc" FontWeight="Bold" Foreground="{StaticResource Interactive}"/><Run Text="  close the palette"/>
                </TextBlock>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ============================== INSPECTOR ============================== -->
        <ScrollViewer x:Name="DebugPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Simulation inspector" Style="{StaticResource Heading}"/>
            <TextBlock Text="Raw career state, event importance, and the memories a character would retrieve."
                       Style="{StaticResource Subheading}"/>
            <Border Style="{StaticResource Card}" Padding="4">
              <TextBox Style="{StaticResource CodeBox}" Text="{Binding DebugText, Mode=OneWay}" IsReadOnly="True"
                       MinHeight="520" Margin="0" BorderThickness="0"/>
            </Border>
          </StackPanel>
        </ScrollViewer>

      </Grid>
    </Grid>

    <!-- ===================================================================================
         Overlays: transient feedback and the command palette
         =================================================================================== -->
    <!-- Clears the header and the sync strip so a toast never covers REVIEW MATCH. -->
    <StackPanel x:Name="ToastHost" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,158,26,0" IsHitTestVisible="False"/>

    <Grid x:Name="PaletteOverlay" Grid.ColumnSpan="2" Background="{StaticResource OverlayScrim}"
          Visibility="Collapsed" MouseLeftButtonDown="ClosePalette_Click">
      <Border Width="620" VerticalAlignment="Top" Margin="0,140,0,0" Background="{StaticResource Panel}"
              BorderBrush="{StaticResource StrokeStrong}" BorderThickness="1" CornerRadius="10" Padding="8"
              MouseLeftButtonDown="SwallowClick">
        <Border.Effect>
          <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.6"/>
        </Border.Effect>
        <StackPanel>
          <TextBox x:Name="PaletteInput" app:Hint.Text="Go to a section or run an action"
                   Margin="0,0,0,8" Padding="14,11" FontSize="15"
                   TextChanged="PaletteInput_TextChanged" PreviewKeyDown="PaletteInput_PreviewKeyDown"/>
          <ListBox x:Name="PaletteResults" MaxHeight="330" MouseDoubleClick="RunPaletteSelection_Click">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" Margin="8,0,0,0"
                             VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding Hint}" Style="{StaticResource Caption}"
                             VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="Enter to run  ·  Esc to close" Style="{StaticResource Caption}" Margin="10,8,0,4"/>
        </StackPanel>
      </Border>
    </Grid>

  </Grid>
</Window>
